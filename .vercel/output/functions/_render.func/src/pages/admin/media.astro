---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { list } from '@vercel/blob';

let blobs: any[] = [];
let error = '';

try {
  const result = await list({
    token: import.meta.env.BLOB_READ_WRITE_TOKEN
  });
  blobs = result.blobs;
} catch (err: any) {
  error = err.message || 'Failed to connect to Vercel Blob.';
}

function formatBytes(bytes: number, decimals = 2) {
  if (!+bytes) return '0 Bytes';
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
}
---

<AdminLayout title="Media Library">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.875rem; font-weight: 700; margin: 0 0 0.5rem 0;">Media Library</h1>
      <p style="color: var(--muted-foreground); margin:0;">Manage images currently hosted on your Vercel cloud server.</p>
    </div>
    
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <input class="input" type="file" id="mediaUploadFile" accept="image/*" style="width: auto; padding: 0.25rem 0.75rem;" />
      <button type="button" id="mediaUploadBtn" class="btn btn-primary">Upload Image</button>
    </div>
  </div>

  <div id="mediaUploadStatus" style="font-size: 0.8rem; margin-bottom: 1rem; color: var(--muted-foreground);"></div>

  {error ? (
    <div style="background: var(--destructive); color: white; padding: 1rem; border-radius: var(--radius); margin-bottom: 1rem;">
      {error}
    </div>
  ) : (
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {blobs.length === 0 ? (
        <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
          <p style="color: var(--muted-foreground);">No media uploaded yet.</p>
        </div>
      ) : (
        blobs.map((blob) => (
          <div class="card" id={`card-${blob.url.replace(/[^a-zA-Z0-9]/g, '')}`} style="display: flex; flex-direction: column; overflow: hidden; padding: 0;">
            <div style="height: 160px; overflow: hidden; background: #eee; display: flex; align-items: center; justify-content: center;">
               <img src={blob.url} alt={blob.pathname} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" decoding="async" />
            </div>
            <div style="padding: 1rem; flex: 1; display: flex; flex-direction: column;">
              <p style="font-weight: 600; font-size: 0.875rem; margin: 0 0 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={blob.pathname}>
                {blob.pathname}
              </p>
              <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0 0 1rem;">
                {formatBytes(blob.size)} &middot; {new Date(blob.uploadedAt).toLocaleDateString()}
              </p>
              <div style="margin-top: auto; display: flex; gap: 0.5rem;">
                <button type="button" class="btn btn-secondary copy-btn" data-url={blob.url} style="flex: 1; font-size: 0.75rem;">
                  Copy URL
                </button>
                <button type="button" class="btn btn-destructive delete-btn" data-url={blob.url} style="font-size: 0.75rem;">
                  Delete
                </button>
              </div>
            </div>
          </div>
        ))
      )}
    </div>
  )}

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Handle Copy
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const url = (e.currentTarget as HTMLButtonElement).dataset.url;
          if (url) {
            await navigator.clipboard.writeText(url);
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Copied!';
            setTimeout(() => { btn.innerHTML = originalText; }, 2000);
          }
        });
      });

      // Handle Delete
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const confirmDelete = confirm('Are you sure you want to permanently delete this image from your Vercel cloud storage? This action cannot be undone.');
          if (!confirmDelete) return;

          const el = e.currentTarget as HTMLButtonElement;
          const url = el.dataset.url;
          const originalText = el.innerHTML;
          
          el.innerHTML = '...';
          el.disabled = true;

          try {
            const response = await fetch('/api/delete-blob', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ url }),
            });

            if (!response.ok) {
               throw new Error("Failed to delete");
            }
            
            // Remove DOM element purely
            const cardId = `card-${url?.replace(/[^a-zA-Z0-9]/g, '')}`;
            const card = document.getElementById(cardId);
            if (card) {
               card.remove();
            }

          } catch (err) {
            console.error(err);
            alert('Failed to delete blob. See console for details.');
            el.innerHTML = originalText;
            el.disabled = false;
          }
        });
      });
      // Handle Upload
      const uploadBtn = document.getElementById('mediaUploadBtn') as HTMLButtonElement;
      const fileInput = document.getElementById('mediaUploadFile') as HTMLInputElement;
      const statusDiv = document.getElementById('mediaUploadStatus') as HTMLDivElement;

      if (uploadBtn && fileInput && statusDiv) {
        uploadBtn.addEventListener('click', async () => {
          const file = fileInput.files?.[0];
          if (!file) {
            alert('Please select an image file first.');
            return;
          }

          uploadBtn.innerText = 'Uploading...';
          uploadBtn.disabled = true;
          statusDiv.innerText = 'Uploading directly to Vercel Blob...';
          statusDiv.style.color = '#854d0e';

          try {
            const response = await fetch(`/api/upload?filename=${encodeURIComponent(file.name)}`, {
              method: 'POST',
              body: file,
            });

            if (!response.ok) {
               const errorObj = await response.json();
               throw new Error(errorObj.error || "Upload failed");
            }
            
            statusDiv.innerText = 'Success! Reloading library...';
            statusDiv.style.color = '#166534';
            window.location.reload();
          } catch (error: any) {
            console.error(error);
            alert('Failed to upload: ' + error.message);
            statusDiv.innerText = 'Upload failed.';
            statusDiv.style.color = '#ef4444';
            uploadBtn.innerText = 'Upload Image';
            uploadBtn.disabled = false;
          }
        });
      }
    });
  </script>
</AdminLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db, BlogPosts, eq } from 'astro:db';

const id = Astro.url.searchParams.get('id');
let post = null;

if (id) {
  const posts = await db.select().from(BlogPosts).where(eq(BlogPosts.id, id));
  if (posts.length > 0) {
    post = posts[0];
  }
}

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const saveId = data.get('id')?.toString();
    const title = data.get('title')?.toString() || '';
    const slug = data.get('slug')?.toString() || title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const excerpt = data.get('excerpt')?.toString() || '';
    const featuredImage = data.get('featuredImage')?.toString() || '/images/default-blog.jpg';
    const author = data.get('author')?.toString() || 'Flyger Editorial Team';
    const category = data.get('category')?.toString() || 'Aviation Insights';
    const featured = data.get('featured') === 'on';
    const body = data.get('body')?.toString() || '';
    const createdAt = new Date(data.get('createdAt')?.toString() || new Date().toISOString());

    if (!slug) throw new Error("Slug could not be generated.");

    if (saveId) {
      // Update
      await db.update(BlogPosts).set({
        id: slug,
        title, excerpt, featuredImage, author, category, featured, body, createdAt
      }).where(eq(BlogPosts.id, saveId));
    } else {
      // Insert
      await db.insert(BlogPosts).values({
        id: slug,
        title, excerpt, featuredImage, author, category, featured, body, createdAt
      });
    }

    return Astro.redirect('/admin/blog');
  } catch (err: any) {
    error = err.message || 'Failed to save post.';
  }
}
---

<AdminLayout title={post ? 'Edit Post' : 'New Post'}>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  
  <style>
    .toolbar-btn {
      background: transparent; border: 1px solid var(--border); border-radius: 4px; padding: 0.25rem 0.5rem;
      font-size: 0.75rem; cursor: pointer; transition: background 0.2s; font-weight: 600; color: var(--foreground);
    }
    .toolbar-btn:hover { background: #e4e4e7; }

    .prose-preview { font-family: 'Inter', sans-serif; line-height: 1.7; color: #3f3f46; }
    .prose-preview h1, .prose-preview h2, .prose-preview h3 { color: #18181b; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; }
    .prose-preview h2 { font-size: clamp(1.2rem, 3vw, 1.5rem); }
    .prose-preview p { margin-bottom: 1.5rem; }
    .prose-preview a { color: #2563eb; text-decoration: underline; }
    .prose-preview blockquote { border-left: 4px solid #e4e4e7; padding-left: 1rem; font-style: italic; color: #71717a; }
    .prose-preview ul, .prose-preview ol { padding-left: 1.5rem; margin-bottom: 1.5rem; }
    .prose-preview li { margin-bottom: 0.5rem; }
    .prose-preview img { max-width: 100%; border-radius: 0.5rem; margin-bottom: 1.5rem; }

    /* ============================================================
       Editor layout + responsive
       ============================================================ */
    .editor-tabs {
      display: none;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding: 0.3rem;
      background: var(--muted);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .editor-tab {
      flex: 1;
      padding: 0.65rem 1rem;
      background: transparent;
      border: none;
      border-radius: calc(var(--radius) - 2px);
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--muted-foreground);
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      min-height: 40px;
    }
    .editor-tab.is-active {
      background: var(--card);
      color: var(--foreground);
      box-shadow: 0 1px 2px rgba(0,0,0,0.06);
    }

    .editor-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      max-width: 1600px;
    }
    .editor-pane {
      min-height: 600px;
    }
    .editor-pane--write {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      overflow-y: auto;
      min-height: 850px;
    }
    .editor-pane--preview {
      overflow-y: auto;
      background: white;
      min-height: 850px;
    }

    .edit-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .edit-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }

    .toolbar { display: flex; gap: 0.5rem; flex-wrap: wrap; background: var(--muted); padding: 0.5rem; border-radius: var(--radius); border-bottom-left-radius: 0; border-bottom-right-radius: 0; border: 1px solid var(--border); }

    .action-row { display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }

    /* Tablet / Mobile: switch to tab mode */
    @media (max-width: 1023px) {
      .editor-tabs { display: flex; }
      .editor-grid {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .editor-pane {
        display: none;
        min-height: 70vh;
      }
      .editor-pane--write {
        min-height: 70vh;
        height: auto;
      }
      .editor-pane--preview {
        min-height: 70vh;
        height: auto;
      }
      .editor-pane--write.is-active {
        display: flex;
      }
      .editor-pane--preview.is-active {
        display: block;
      }
      .edit-grid-3 { grid-template-columns: 1fr 1fr; }
    }

    /* Mobile: collapse nested grids + bigger toolbar buttons */
    @media (max-width: 640px) {
      .edit-grid-2 { grid-template-columns: 1fr; }
      .edit-grid-3 { grid-template-columns: 1fr; }
      .toolbar-btn {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        min-height: 40px;
        min-width: 40px;
      }
      .action-row {
        flex-direction: column;
        align-items: stretch;
      }
      .action-row .btn {
        width: 100%;
      }
    }
  </style>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: clamp(1.4rem, 4vw, 1.875rem); font-weight: 700; margin: 0 0 0.5rem 0;">{post ? 'Edit Post' : 'Create New Post'}</h1>
      <p style="color: var(--muted-foreground); margin:0; font-size: clamp(0.85rem, 2vw, 0.95rem);">Write on the left, preview on the right. On mobile, tap Write / Preview to switch.</p>
    </div>
    <a href="/admin/blog" class="btn btn-secondary">Cancel</a>
  </div>

  {error && (
    <div style="background: var(--destructive); color: white; padding: 1rem; border-radius: var(--radius); margin-bottom: 1rem;">
      {error}
    </div>
  )}

  <!-- Tabs (mobile/tablet only — hidden on desktop via CSS) -->
  <div class="editor-tabs" role="tablist">
    <button type="button" class="editor-tab is-active" data-pane="write" role="tab">Write</button>
    <button type="button" class="editor-tab" data-pane="preview" role="tab">Preview</button>
  </div>

  <div class="editor-grid">

    <!-- LEFT PANE: Editor -->
    <form method="POST" class="card editor-pane editor-pane--write is-active">
      {post && <input type="hidden" name="id" value={post.id} />}

      <div class="edit-grid-2">
        <div>
          <label class="label" for="title">Title</label>
          <input class="input" type="text" id="title" name="title" required value={post?.title || ''} />
        </div>
        <div>
          <label class="label" for="slug">URL Slug (identifier)</label>
          <input class="input" type="text" id="slug" name="slug" placeholder="leave blank to auto-generate" value={post?.id || ''} />
        </div>
      </div>

      <div class="edit-grid-3">
        <div>
          <label class="label" for="category">Category</label>
          <select class="input" id="category" name="category">
            <option value="Aviation Insights" selected={post?.category === 'Aviation Insights'}>Aviation Insights</option>
            <option value="Company Updates" selected={post?.category === 'Company Updates'}>Company Updates</option>
            <option value="Industry News" selected={post?.category === 'Industry News'}>Industry News</option>
            <option value="Technology" selected={post?.category === 'Technology'}>Technology</option>
          </select>
        </div>
        <div>
          <label class="label" for="author">Author</label>
          <input class="input" type="text" id="author" name="author" value={post?.author || 'Flyger Editorial Team'} />
        </div>
        <div>
          <label class="label" for="createdAt">Publish Date</label>
          <input class="input" type="date" id="createdAt" name="createdAt" value={post ? new Date(post.createdAt).toISOString().split('T')[0] : new Date().toISOString().split('T')[0]} />
        </div>
      </div>

      <div>
        <label class="label" for="featuredImageFile">Featured Image</label>
        <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap;">
          <input class="input" type="file" id="featuredImageFile" accept="image/*" style="flex: 1; padding: 0.25rem 0.75rem; min-width: 200px;" />
          <button type="button" id="uploadBtn" class="btn btn-secondary">Upload New</button>
          <span style="color: var(--muted-foreground); font-size: 0.875rem;">- or -</span>
          <button type="button" id="openLibraryBtn" class="btn btn-secondary">Select from Library</button>
        </div>

        <!-- Hidden Media Library Dropdown Container -->
        <div id="mediaLibraryModal" style="display: none; border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 0.5rem; background: var(--muted);">
           <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
             <span style="font-weight: 600; font-size: 0.875rem;">Select an image...</span>
             <button type="button" id="closeLibraryBtn" class="btn btn-secondary" style="height: 1.5rem; font-size: 0.75rem; padding: 0 0.5rem;">Close</button>
           </div>
           <div id="mediaLibraryGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 0.5rem; max-height: min(300px, 40vh); overflow-y: auto;">
              <p style="font-size: 0.8rem; color: var(--muted-foreground);">Loading library...</p>
           </div>
        </div>

        <input type="hidden" id="featuredImage" name="featuredImage" value={post?.featuredImage || '/images/default-blog.jpg'} required />
        <div id="uploadStatus" style="font-size: 0.75rem; color: var(--muted-foreground);">
          Current Image: <a href={post?.featuredImage || '/images/default-blog.jpg'} target="_blank" style="color: var(--primary); text-decoration: underline;" id="currentImageLink">View File</a>
        </div>
      </div>

      <div>
        <label class="label" for="excerpt">Excerpt (Short Summary)</label>
        <textarea class="input" id="excerpt" name="excerpt" style="height: 60px; padding: 0.5rem 0.75rem 0;" required>{post?.excerpt || ''}</textarea>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column;">
        <label class="label" for="body">Body (Markdown Supported)</label>
        
        <!-- Markdown Toolbar -->
        <div class="toolbar" style="margin-bottom: -1px;">
           <button type="button" class="toolbar-btn" data-action="bold" title="Bold">B</button>
           <button type="button" class="toolbar-btn" data-action="italic" title="Italic">I</button>
           <button type="button" class="toolbar-btn" data-action="h2" title="Heading 2">H2</button>
           <button type="button" class="toolbar-btn" data-action="quote" title="Quote">"</button>
           <button type="button" class="toolbar-btn" data-action="link" title="Link">Link</button>
           <button type="button" class="toolbar-btn" data-action="image" title="Image">Img</button>
           <button type="button" class="toolbar-btn" data-action="list" title="Bullet List">List</button>
        </div>
        
        <textarea class="input" id="body" name="body" style="flex: 1; padding: 1rem; font-family: ui-monospace, monospace; font-size: 0.875rem; border-top-left-radius: 0; border-top-right-radius: 0;" required>{post?.body || ''}</textarea>
      </div>

      <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem;">
        <input type="checkbox" id="featured" name="featured" checked={post?.featured} />
        <label for="featured" class="label" style="margin:0;">Make this a Featured Post</label>
      </div>

      <div class="action-row">
        <button type="submit" class="btn btn-primary" style="padding: 0 2rem; min-height: 44px;">Save Post</button>
      </div>
    </form>

    <!-- RIGHT PANE: Live Preview -->
    <div class="card editor-pane editor-pane--preview">
      <h2 style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted-foreground); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-top: 0;">Live Preview</h2>

      <!-- Preview Header injected dynamically -->
      <div id="previewHeader" style="margin-bottom: 2rem;">
        <span id="previewCategory" style="color: #2563eb; font-weight: 600; font-size: 0.875rem;">Category</span>
        <h1 id="previewTitle" style="font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; margin: 0.5rem 0;">Blog Title</h1>
        <p id="previewExcerpt" style="font-size: clamp(0.95rem, 2vw, 1.125rem); color: #52525b;">Excerpt goes here...</p>
        <img id="previewImage" src="/images/default-blog.jpg" style="width: 100%; height: auto; border-radius: 0.5rem; margin-top: 1.5rem;" />
      </div>

      <!-- Preview Body -->
      <div id="previewBody" class="prose-preview">
      </div>
    </div>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const uploadBtn = document.getElementById("uploadBtn") as HTMLButtonElement;
      const fileInput = document.getElementById("featuredImageFile") as HTMLInputElement;
      const hiddenInput = document.getElementById("featuredImage") as HTMLInputElement;
      const statusDiv = document.getElementById("uploadStatus") as HTMLDivElement;

      if(uploadBtn && fileInput && hiddenInput && statusDiv) {
        uploadBtn.addEventListener("click", async () => {
          const file = fileInput.files?.[0];
          if (!file) {
            alert("Please select a file first.");
            return;
          }

          uploadBtn.innerText = "Uploading...";
          uploadBtn.disabled = true;
          statusDiv.innerText = "Uploading to Vercel Blob...";
          statusDiv.style.color = "#854d0e"; // subtle warning color

          try {
            const response = await fetch(`/api/upload?filename=${encodeURIComponent(file.name)}`, {
              method: 'POST',
              body: file,
            });

            if (!response.ok) {
               const errorObj = await response.json();
               throw new Error(errorObj.error || "Upload failed");
            }

            const newBlob = await response.json();
            
            // Set the Database URL
            hiddenInput.value = newBlob.url;
            
            // Update UI
            statusDiv.innerHTML = `Success! Image stored securely at: <a href="${newBlob.url}" target="_blank" style="color: #166534; text-decoration: underline;">View Upload</a>`;
            statusDiv.style.color = "#166534";
            
            // Trigger Live Preview Update
            if (typeof updatePreview !== 'undefined') updatePreview();
          } catch (error: any) {
            console.error(error);
            alert("Failed to upload: " + error.message);
            statusDiv.innerText = "Upload failed. Try again.";
            statusDiv.style.color = "#ef4444";
          } finally {
            uploadBtn.innerText = "Upload New";
            uploadBtn.disabled = false;
          }
        });
      }

      // Media Library Selector Logic
      const openLibraryBtn = document.getElementById("openLibraryBtn") as HTMLButtonElement;
      const closeLibraryBtn = document.getElementById("closeLibraryBtn") as HTMLButtonElement;
      const mediaLibraryModal = document.getElementById("mediaLibraryModal") as HTMLDivElement;
      const mediaLibraryGrid = document.getElementById("mediaLibraryGrid") as HTMLDivElement;
      const currentImageLink = document.getElementById("currentImageLink") as HTMLAnchorElement;

      if (openLibraryBtn && closeLibraryBtn && mediaLibraryModal && mediaLibraryGrid) {
        openLibraryBtn.addEventListener("click", async () => {
          mediaLibraryModal.style.display = "block";
          try {
            const res = await fetch('/api/list-blobs');
            const blobs = await res.json();
            
            if (blobs.length === 0) {
              mediaLibraryGrid.innerHTML = '<p style="font-size: 0.8rem; color: var(--muted-foreground);">Library is empty.</p>';
              return;
            }

            mediaLibraryGrid.innerHTML = blobs.map((b: any) => `
              <div class="library-item" style="cursor: pointer; border: 2px solid transparent; border-radius: var(--radius); overflow: hidden; height: 80px;" data-url="${b.url}">
                <img src="${b.url}" style="width: 100%; height: 100%; object-fit: cover;" title="${b.pathname}" />
              </div>
            `).join('');

            // Add click handlers for selection
            mediaLibraryGrid.querySelectorAll('.library-item').forEach(item => {
              item.addEventListener('click', (e) => {
                const url = (e.currentTarget as HTMLDivElement).dataset.url;
                if (url) {
                  hiddenInput.value = url;
                  currentImageLink.href = url;
                  statusDiv.innerHTML = `Success! Image selected: <a href="${url}" target="_blank" style="color: #166534; text-decoration: underline;">View Select</a>`;
                  statusDiv.style.color = "#166534";
                  mediaLibraryModal.style.display = "none";
                  
                  // Trigger Live Preview Update
                  if (typeof updatePreview !== 'undefined') updatePreview();
                }
              });
            });

          } catch (e) {
            mediaLibraryGrid.innerHTML = '<p style="color: var(--destructive); font-size: 0.8rem;">Failed to load library.</p>';
          }
        });

        closeLibraryBtn.addEventListener("click", () => {
          mediaLibraryModal.style.display = "none";
        });
      }

      // Live Preview & Toolbar Logic
      const titleInput = document.getElementById("title") as HTMLInputElement;
      const categoryInput = document.getElementById("category") as HTMLSelectElement;
      const excerptInput = document.getElementById("excerpt") as HTMLTextAreaElement;
      const bodyInput = document.getElementById("body") as HTMLTextAreaElement;
      
      const previewTitle = document.getElementById("previewTitle") as HTMLHeadingElement;
      const previewCategory = document.getElementById("previewCategory") as HTMLSpanElement;
      const previewExcerpt = document.getElementById("previewExcerpt") as HTMLParagraphElement;
      const previewImage = document.getElementById("previewImage") as HTMLImageElement;
      const previewBody = document.getElementById("previewBody") as HTMLDivElement;

      // marked is loaded from CDN onto window
      const markedLib = (window as any).marked;

      function updatePreview() {
        if(titleInput) previewTitle.innerText = titleInput.value || 'Blog Title';
        if(categoryInput) previewCategory.innerText = categoryInput.value || 'Category';
        if(excerptInput) previewExcerpt.innerText = excerptInput.value || 'Excerpt goes here...';
        if(hiddenInput) previewImage.src = hiddenInput.value || '/images/default-blog.jpg';

        if (bodyInput && markedLib) {
          previewBody.innerHTML = markedLib.parse(bodyInput.value);
        }
      }

      [titleInput, categoryInput, excerptInput, bodyInput].forEach(input => {
        if(input) {
           input.addEventListener('input', updatePreview);
        }
      });
      if(categoryInput) categoryInput.addEventListener('change', updatePreview);

      // Toolbar interactions
      document.querySelectorAll('.toolbar-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const action = (e.currentTarget as HTMLButtonElement).dataset.action;
          if (!bodyInput) return;
          
          const start = bodyInput.selectionStart;
          const end = bodyInput.selectionEnd;
          const text = bodyInput.value;
          const selectedText = text.substring(start, end);
          
          let insertText = '';
          let cursorOffset = 0;

          switch(action) {
            case 'bold': insertText = `**${selectedText || 'bold text'}**`; cursorOffset = 2; break;
            case 'italic': insertText = `*${selectedText || 'italic text'}*`; cursorOffset = 1; break;
            case 'h2': insertText = `\n## ${selectedText || 'Heading 2'}\n`; cursorOffset = 4; break;
            case 'quote': insertText = `\n> ${selectedText || 'quote'}\n`; cursorOffset = 3; break;
            case 'link': insertText = `[${selectedText || 'link text'}](https://)`; cursorOffset = 1; break;
            case 'image': insertText = `![${selectedText || 'alt text'}](url)`; cursorOffset = 2; break;
            case 'list': insertText = `\n- ${selectedText || 'item'}\n`; cursorOffset = 3; break;
          }

          bodyInput.value = text.substring(0, start) + insertText + text.substring(end);
          bodyInput.focus();
          // Adjust cursor to inside the formatting tags for convenience
          if (start === end) {
             bodyInput.selectionStart = start + cursorOffset;
             bodyInput.selectionEnd = start + cursorOffset + (insertText.length - cursorOffset * 2);
          } else {
             bodyInput.selectionStart = start;
             bodyInput.selectionEnd = start + insertText.length;
          }
          
          updatePreview();
        });
      });

      // Editor tab switcher (mobile/tablet only — no-op on desktop where tabs are hidden)
      document.querySelectorAll<HTMLButtonElement>('.editor-tab').forEach((tab) => {
        tab.addEventListener('click', (e) => {
          const currentTab = e.currentTarget as HTMLButtonElement;
          const target = currentTab.dataset.pane;
          if (!target) return;
          document.querySelectorAll('.editor-tab').forEach((t) =>
            t.classList.toggle('is-active', t === currentTab)
          );
          document.querySelectorAll('.editor-pane').forEach((p) =>
            p.classList.toggle('is-active', p.classList.contains(`editor-pane--${target}`))
          );
        });
      });

      // Initial render
      setTimeout(updatePreview, 500);

    });
  </script>
</AdminLayout>

{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/blog/edit/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/inquiries/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/media/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/delete-blob/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/list-blobs/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/migrate-blogs/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/seed/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/seed-blob-blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/submit-inquiry/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/consultancy/uae-airports/?$",
			"dest": "_render"
		},
		{
			"src": "^/consultancy/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact-us/?$",
			"dest": "_render"
		},
		{
			"src": "^/fuel/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip-support/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}
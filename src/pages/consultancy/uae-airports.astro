---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';

const WHATSAPP = '971501234567'; // Change to actual
const EMAIL    = 'ops@flyger.aero';

const airports = [
  { name: 'Zayed International Airport', city: 'Abu Dhabi', iata: 'AUH', icao: 'OMAA', img: 'https://images.unsplash.com/photo-1542296332-2e4473faf563?q=80&w=1200' },
  { name: 'Al Bateen Executive Airport', city: 'Abu Dhabi', iata: 'AZI', icao: 'OMAD', img: 'https://images.unsplash.com/photo-1556388158-158ea5ccacbd?q=80&w=1200' },
  { name: 'Al Ain International Airport', city: 'Al Ain',    iata: 'AAN', icao: 'OMAL', img: 'https://images.unsplash.com/photo-1506012787146-f92b2d7d6d96?q=80&w=1200' },
  { name: 'Dubai International Airport', city: 'Dubai',     iata: 'DXB', icao: 'OMDB', img: '/images/uae-dubai_airport.webp' },
  { name: 'Al Maktoum International Airport', city: 'Dubai (DWC)', iata: 'DWC', icao: 'OMDW', img: '/images/uae-al_maktoum_airport.webp' },
  { name: 'Sharjah International Airport', city: 'Sharjah',   iata: 'SHJ', icao: 'OMSJ', img: 'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=1200' },
  { name: 'Ras Al Khaimah International Airport',city: 'RAK', iata: 'RKT', icao: 'OMRK', img: '/images/uae-rak_airport.webp' },
  { name: 'Fujairah International Airport', city: 'Fujairah',  iata: 'FJR', icao: 'OMFJ', img: 'https://images.unsplash.com/photo-1464037866556-6812c9d1c72e?q=80&w=1200' },
  { name: 'Sir Bani Yas Airport', city: 'Sir Bani Yas', iata: 'XSB', icao: 'OMBY', img: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?q=80&w=1200' },
];
---

<MainLayout title="UAE Airports Network — Flyger Consultancy">
  <Navbar />

  <main class="ua-main">
    <!-- Header -->
    <header class="ua-header">
      <a href="/consultancy" class="ua-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Consultancy
      </a>
      <h1 class="ua-title">UAE Airports Network</h1>
      <p class="ua-desc">
        We provide priority handling and extensive support at all 9 major terminals in the UAE. Get in touch with our fast-response operations team directly.
      </p>
    </header>

    <!-- Airports Grid -->
    <div class="ua-grid-container">
      <div class="ua-grid">
        {airports.map((ap) => {
          const encodedName = encodeURIComponent(`Hi Flyger, I'd like to enquire about flight support at ${ap.name} (${ap.iata}).`);
          const subj = encodeURIComponent(`Consultancy Inquiry: ${ap.name} (${ap.iata})`);
          
          const waUrl = `https://wa.me/${WHATSAPP}?text=${encodedName}`;
          const emailUrl = `mailto:${EMAIL}?subject=${subj}`;

          return (
            <div class="ca-card">
              <div class="ca-card-img-wrapper">
                <img src={ap.img} alt={ap.name} class="ca-card-img" loading="lazy" decoding="async" />
                <div class="ca-card-gradient"></div>
              </div>
              <div class="ca-card-content">
                <h2 class="ca-card-name" set:html={ap.name.replace(' ', '<br/>')} />
                
                <div class="ca-card-bullets">
                  <div class="ca-bullet"><span class="ca-bullet-dot">°</span><span>IATA: {ap.iata}</span></div>
                  <div class="ca-bullet"><span class="ca-bullet-dot">°</span><span>ICAO: {ap.icao}</span></div>
                  <div class="ca-bullet"><span class="ca-bullet-dot">°</span><span>VIP Handling</span></div>
                  <div class="ca-bullet"><span class="ca-bullet-dot">°</span><span>24/7 Ops</span></div>
                </div>
                
                <!-- Direct Inline Contact Actions -->
                <div class="ca-card-actions">
                  <a href={waUrl} class="ca-btn ca-btn-wa" target="_blank" rel="noopener" aria-label={`WhatsApp operations for ${ap.name}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    WhatsApp
                  </a>
                  <a href={emailUrl} class="ca-btn ca-btn-email" target="_blank" rel="noopener" aria-label={`Email operations for ${ap.name}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                      <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    Email
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>

<style>
  /* ── Layout ── */
  .ua-main {
    background: #000000;
    min-height: 100vh;
    padding-top: 5rem;
    padding-bottom: 8rem;
  }

  .ua-header {
    text-align: center;
    padding: 5rem 1.5rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .ua-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .ua-back:hover { color: #fff; }

  .ua-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    font-family: 'Inter', system-ui, sans-serif;
    color: #ffffff;
    margin: 0 0 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .ua-desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto;
  }

  /* ── Grid ── */
  .ua-grid-container {
    padding: 0 2.5rem;
    max-width: 1440px;
    margin: 0 auto;
  }
  .ua-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* ── Card Styles (Jetvia Inspired) ── */
  .ca-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Push content to bottom */
    background: #050505;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    min-height: 540px; /* Tall elegant proportion */
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .ca-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    border-color: rgba(255,255,255,0.15);
  }

  .ca-card-img-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .ca-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .ca-card:hover .ca-card-img {
    transform: scale(1.05);
  }
  .ca-card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 30%, rgba(0,0,0,0) 80%);
  }

  .ca-card-content {
    position: relative;
    z-index: 1;
    padding: 2.5rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
  }
  .ca-card-name {
    font-size: 2.25rem; /* Larger, elegant title */
    font-weight: 300; /* Thin font like Jetvia */
    font-family: 'Inter', system-ui, sans-serif;
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .ca-card-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
    margin: 0 0 1.5rem;
    font-weight: 300;
  }
  .ca-card-bullets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 0.75rem;
    margin-bottom: 2rem;
    opacity: 0.8;
  }
  .ca-bullet {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
  }
  .ca-bullet-dot {
    font-size: 0.95rem;
    line-height: 0.8;
    color: var(--color-primary, #4BA3C3);
  }

  .ca-card-actions {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .ca-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.85rem 1rem;
    border-radius: 999px; /* Pill shape matching Jetvia */
    transition: all 0.25s;
    background: #ffffff;
    color: #000000;
  }
  
  .ca-btn-wa:hover, .ca-btn-email:hover {
    background: #e2e8f0;
    transform: translateY(-2px);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .ua-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 650px) {
    .ua-grid { grid-template-columns: 1fr; }
    .ua-grid-container { padding: 0 1.5rem; }
  }
</style>

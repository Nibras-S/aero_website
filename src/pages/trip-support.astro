---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";

// Trip Support modular components
import TripSupportIntro from "../components/sections/trip-support/TripSupportIntro.astro";
import ClienteleStatement from "../components/sections/trip-support/ClienteleStatement.astro";
import ServicesGrid from "../components/sections/trip-support/ServicesGrid.astro";
import FlygerCRM from "../components/sections/trip-support/FlygerCRM.astro";
import StationRepDetails from "../components/sections/trip-support/StationRepDetails.astro";
import GlobalReach from "../components/sections/trip-support/GlobalReach.astro";
---

<MainLayout title="Trip Support | Flyger Aviation Services">
  <Navbar />
  <main>
    <TripSupportIntro />
    <ClienteleStatement />
    <ServicesGrid />
    <FlygerCRM />
    <StationRepDetails />
    <GlobalReach />
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>

<style is:global>
  /* Strict global single-scroll switching (Desktop Only) */
  html {
    scroll-behavior: smooth;
  }

  @media (min-width: 1024px) {
    html {
      scroll-snap-type: y mandatory;
    }

    main > section, 
    footer {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  /* Cinematic Page Transition States */
  .cinematic-section {
    transition: filter 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), 
                opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), 
                transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform: scale(0.97);
    filter: blur(10px);
    opacity: 0.4;
    will-change: filter, opacity, transform;
  }
  
  .cinematic-section.is-focused {
    transform: scale(1);
    filter: blur(0px);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Select all top-level section blocks inside main (ignores modals/overlays)
    const sections = Array.from(document.querySelectorAll('main > section'));
    
    // We want the 'active' zone to be the middle of the screen.
    // Anything outside the middle 50% starts blurring out.
    const observerOptions = {
      root: null,
      rootMargin: "-25% 0px -25% 0px", 
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-focused');
        } else {
          entry.target.classList.remove('is-focused');
        }
      });
    }, observerOptions);

    sections.forEach(sec => {
      // Add the animation class to every section chunk
      sec.classList.add('cinematic-section');
      observer.observe(sec);
    });

    // To ensure the very first section (Hero) is visible immediately on load 
    // before the observer fully takes over:
    if (sections[0]) setTimeout(() => sections[0].classList.add('is-focused'), 50);
  });
</script>

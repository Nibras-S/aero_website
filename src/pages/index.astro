---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

// Sections
import Hero from "../components/sections/Hero.astro";
import AboutIntro from "../components/sections/about/AboutIntro.astro";
import TripSupportIntro from "../components/sections/trip-support/TripSupportIntro.astro";
import CinematicTransition from "../components/sections/CinematicTransition.astro";
import FuelServices from "../components/sections/FuelServices.astro";
import Consultancy from "../components/sections/Consultancy.astro";
import CompanyProfile from "../components/sections/CompanyProfile.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
---

<MainLayout title="Flyger Aviation Services">
  <Navbar />
  <main>
    <Hero />
    <div class="h-0 md:h-48 w-full bg-gradient-to-b from-[#080e16] to-black"></div>
    <PlaneWindowSection />
    <div class="h-0 md:h-32 w-full bg-gradient-to-b from-black to-[#090d14]"></div>
    <AboutIntro />
    <TripSupportIntro />
    <CinematicTransition />
    <FuelServices />
    <Consultancy />
    <CompanyProfile />
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

// Sections
import Hero from '../components/sections/Hero.astro';
import PlaneWindowSection from '../components/sections/PlaneWindowSection.astro';
import AboutIntro from '../components/sections/about/AboutIntro.astro';
import TripSupportIntro from '../components/sections/trip-support/TripSupportIntro.astro';
import FlightSupportServices from '../components/sections/FlightSupportServices.astro';
import CinematicTransition from '../components/sections/CinematicTransition.astro';
import Consultancy from '../components/sections/Consultancy.astro';
import CompanyProfile from '../components/sections/CompanyProfile.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
---

<MainLayout title="Flyger Aviation Services">
  <Navbar />
  <main>
    <Hero />
    <div class="h-32 md:h-48 w-full bg-gradient-to-b from-[#080e16] to-black -mt-[1px] relative z-10"></div>
    <PlaneWindowSection />
    <div class="h-0 md:h-32 w-full bg-gradient-to-b from-black to-[#090d14] -mt-[1px] relative z-10"></div>
    <AboutIntro />
    <FlightSupportServices />
    <CinematicTransition />
    <Consultancy />
    <CompanyProfile />
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>

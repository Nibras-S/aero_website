---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

// Sections
import Hero from '../components/sections/Hero.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import TripSupport from '../components/sections/TripSupport.astro';
import CinematicTransition from '../components/sections/CinematicTransition.astro';
import FuelServices from '../components/sections/FuelServices.astro';
import Consultancy from '../components/sections/Consultancy.astro';
import CompanyProfile from '../components/sections/CompanyProfile.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
---

<MainLayout title="Flyger Aviation Services">
  <Navbar />
  <main>
    <Hero />
    <AboutUs />
    <TripSupport />
    <CinematicTransition />
    <FuelServices />
    <Consultancy />
    <CompanyProfile />
    <ContactCTA />
  </main>
  <Footer />
</MainLayout>

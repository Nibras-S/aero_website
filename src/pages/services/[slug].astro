<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("gallery-pin");
    if (!container) return;

    const thumbs = document.querySelectorAll(".gallery__thumb-wrapper");
    const canvases = document.querySelectorAll(".gallery__canvas-item");
    const contents = document.querySelectorAll(".gallery__content-item");
    const numItems = thumbs.length;

    if (numItems === 0) return;

    const handleScroll = () => {
      if (window.innerWidth <= 1000) return;
      const rect = container.getBoundingClientRect();
      const trackHeight = rect.height - window.innerHeight;

      let progress = 0;
      if (rect.top <= 0) {
        progress = Math.abs(rect.top) / trackHeight;
      }
      progress = Math.max(0, Math.min(1, progress));

      let activeIndex = Math.floor(progress * numItems);
      if (activeIndex >= numItems) activeIndex = numItems - 1;

      // Update classes gracefully based on scroll index
      thumbs.forEach((thumb, i) => {
        if (i === activeIndex) {
          thumb.classList.add("is-active");
        } else {
          thumb.classList.remove("is-active");
        }
      });

      canvases.forEach((canvas, i) => {
        if (i === activeIndex) {
          canvas.classList.add("is-active");
        } else {
          canvas.classList.remove("is-active");
        }
      });

      contents.forEach((content, i) => {
        if (i === activeIndex) {
          content.classList.add("is-active");
        } else {
          content.classList.remove("is-active");
        }
      });
    };

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (window.innerWidth <= 1000) return;
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScroll();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    // Initialize state
    handleScroll();
  });
</script>

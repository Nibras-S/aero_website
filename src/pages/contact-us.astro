---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CountrySelect from "../components/ui/CountrySelect.astro";
---

<MainLayout
  title="Contact Us | Flyger Aviation Services"
  description="Get in touch with Flyger’s global operations team for round-the-clock aviation and trip support."
>
  <Navbar />

  <main class="contact-page">
    <!-- ═══ HERO ═══ -->
    <section class="hero" aria-label="Contact Us">
      <div class="hero__bg">
        <!-- Using flight image with a heavy dark overlay -->
        <img loading="lazy" decoding="async"
          src="/images/flight.webp"
          alt="Aviation Background"
          class="hero__img"
          loading="eager"
        />
        <div class="hero__overlay" aria-hidden="true"></div>
      </div>
      <div class="hero__content container">
        <span class="hero__label">24/7 GLOBAL SUPPORT</span>
        <h1 class="hero__title">Contact Us.</h1>
        <p class="hero__tagline">
          Our operations center is always on standby, ready to support your
          aviation needs worldwide. We aim to respond within 15 minutes.
        </p>
      </div>
    </section>

    <!-- ═══ SPLIT MATRIX ═══ -->
    <section class="contact-matrix">
      <div class="container matrix-grid">
        <!-- LEFT: GLOBAL NETWORK -->
        <div class="matrix-network">
          <h2 class="matrix__heading">Global Reach.<br />Local Expertise.</h2>
          <p class="matrix__desc">
            Operating from key aviation hubs, we coordinate your operational
            needs directly on the ground.
          </p>

          <div class="network-cards">
            <!-- HQ Card -->
            <div class="network-card">
              <div class="network-card__icon-wrap">
                <svg
                  class="network-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="network-card__info">
                <h3 class="network-card__city">Global Operations Center</h3>
                <p class="network-card__detail">
                  Available 24/7/365 for immediate dispatch, permits, and
                  mission-critical support.
                </p>
                <div class="network-card__contact">
                  <a href="tel:+971501234567" class="contact-link">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                      ></path>
                    </svg>
                    +971 50 123 4567
                  </a>
                  <a href="mailto:ops@flyger.aero" class="contact-link">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      ></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    ops@flyger.aero
                  </a>
                  <span class="contact-link static">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                      <path
                        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                      ></path>
                    </svg>
                    AFTN: KFLYGRX
                  </span>
                </div>
              </div>
            </div>

            <!-- Regional Hub -->
            <div class="network-card">
              <div class="network-card__icon-wrap">
                <svg
                  class="network-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div class="network-card__info">
                <h3 class="network-card__city">Dubai, UAE HQ</h3>
                <p class="network-card__detail">
                  DSO-IFZA, IFZA Properties,<br />
                  Dubai Silicon Oasis
                </p>
                <div class="network-card__contact">
                  <a href="tel:+971501234567" class="contact-link">
                    +971 50 123 4567
                  </a>
                  <a href="mailto:ops@flyger.aero" class="contact-link">
                    ops@flyger.aero
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: INQUIRY FORM -->
        <div class="matrix-form-wrapper">
          <div class="form-container">
            <div class="form-header">
              <h3>Submit an Inquiry</h3>
              <p>
                Provide your mission details below and our team will generate a
                proposal or respond immediately.
              </p>
            </div>

            <form class="contact-form" id="mainContactForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name</label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    placeholder="John"
                    required
                  />
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name</label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    placeholder="Doe"
                    required
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="company">Company</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    placeholder="Aviation Corp"
                  />
                </div>
                <div class="form-group">
                  <label for="email">Work Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="john@company.com"
                    required
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Phone Number</label>
                  <div class="phone-input-group">
                    <div class="country-code-wrapper">
                      <CountrySelect name="countryCode" defaultValue="+971" />
                    </div>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      placeholder="50 123 4567"
                      pattern="[0-9+\s\-]*"
                      required
                    />
                  </div>
                </div>
                <div class="form-group">
                  <label for="service">Service Required</label>
                  <div class="select-wrapper">
                    <select id="service" name="service" required>
                      <option value="" disabled selected
                        >Select a service...</option
                      >
                      <option value="trip-planning"
                        >Trip Planning & Flight Permits</option
                      >
                      <option value="ground-handling"
                        >Ground Handling & Supervision</option
                      >
                      <option value="fuel">Fuel Solutions</option>
                      <option value="concierge"
                        >Executive Concierge & VIP Logistics</option
                      >
                      <option value="crm">Flyger CRM Demo</option>
                      <option value="other">Other / General Inquiry</option>
                    </select>
                    <!-- Custom dropdown arrow -->
                    <svg
                      class="select-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      ><polyline points="6 9 12 15 18 9"></polyline></svg
                    >
                  </div>
                </div>
              </div>

              <div class="form-group form-group--full">
                <label for="message">Message / Mission Details</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Briefly describe your route, timeline, or requirements..."
                  required></textarea>
              </div>

              <div class="form-footer">
                <button type="submit" class="btn-submit">
                  <span>Send Inquiry</span>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                </button>
                >
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>

<style>
  /* ── Reset & base ── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-label, "Sora", sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary, #4ba3c3);
    margin-bottom: 0.75rem;
  }

  /* ══════════════════════════════════
     HERO
  ══════════════════════════════════ */
  .hero {
    position: relative;
    height: 70svh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.04);
    transition: transform 6s ease;
  }
  .hero:hover .hero__img {
    transform: scale(1);
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(7, 19, 31, 1) 0%,
      rgba(7, 19, 31, 0.8) 50%,
      rgba(7, 19, 31, 0.4) 100%
    );
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .hero__label {
    font-family: var(--font-label, "Sora", sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary, #4ba3c3);
    background: rgba(75, 163, 195, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    border: 1px solid rgba(75, 163, 195, 0.2);
  }
  .hero__title {
    font-family: var(--font-heading, "Plus Jakarta Sans", sans-serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
  }
  .hero__tagline {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.7);
    max-width: 54ch;
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  /* ══════════════════════════════════
     CONTACT MATRIX (SPLIT LAYOUT)
  ══════════════════════════════════ */
  .contact-matrix {
    background: #07131f;
    padding: 5rem 0 8rem;
    position: relative;
  }

  /* Subtle background glow to add a "cinematic" touch */
  .contact-matrix::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(75, 163, 195, 0.05) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .matrix-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── LEFT: Network Info ── */
  .matrix-network {
    display: flex;
    flex-direction: column;
  }

  .matrix__heading {
    font-family: var(--font-heading, "Plus Jakarta Sans", sans-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .matrix__desc {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #9ca3af;
    margin-bottom: 3rem;
    max-width: 40ch;
  }

  .network-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .network-card {
    display: flex;
    gap: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.75rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }
  .network-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(75, 163, 195, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .network-card__icon-wrap {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: rgba(75, 163, 195, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary, #4ba3c3);
  }
  .network-card__icon {
    width: 24px;
    height: 24px;
  }

  .network-card__info {
    display: flex;
    flex-direction: column;
  }

  .network-card__city {
    font-family: var(--font-heading, "Plus Jakarta Sans", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .network-card__detail {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.9rem;
    color: #9ca3af;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .network-card__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label, "Sora", sans-serif);
    font-size: 0.8rem;
    font-weight: 500;
    color: #e5e7eb;
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-link svg {
    width: 14px;
    height: 14px;
    color: var(--color-primary, #4ba3c3);
    opacity: 0.7;
  }
  .contact-link:not(.static):hover {
    color: var(--color-primary, #4ba3c3);
  }
  .contact-link:not(.static):hover svg {
    opacity: 1;
  }

  /* ── RIGHT: Inquiry Form ── */
  .matrix-form-wrapper {
    width: 100%;
  }

  .form-container {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .form-header {
    margin-bottom: 2rem;
  }
  .form-header h3 {
    font-family: var(--font-heading, "Plus Jakarta Sans", sans-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }
  .form-header p {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .phone-input-group {
    display: flex;
    align-items: stretch;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    transition: all 0.3s ease;
    width: 100%;
  }
  
  .phone-input-group:focus-within {
    border-color: var(--color-primary, #4ba3c3);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 0 0 3px rgba(75, 163, 195, 0.15);
  }

  .country-code-wrapper {
    flex-shrink: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
  }
  
  /* Override the default styling of the CountrySelect trigger when placed tightly in this group */
  .country-code-wrapper :global(.select-trigger) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 8px 0 0 8px; /* Remove right radiuses inside the group */
    padding-left: 0.75rem !important;
    padding-right: 0.5rem !important;
  }

  .phone-input-group input[type="tel"] {
    flex: 1 1 0%;
    min-width: 0;
    width: 100%;
    background: transparent !important;
    border: none !important;
    border-radius: 0 8px 8px 0 !important;
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
    text-overflow: ellipsis;
  }
  
  .phone-input-group input[type="tel"]:focus,
  .country-code-wrapper :global(.select-trigger:focus) {
    box-shadow: none !important;
    border: none !important;
    outline: none !important;
  }

  @media (max-width: 600px) {
    .phone-input-group {
      flex-direction: row; /* Keep them together horizontally */
    }
  }

  .form-group--full {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-family: var(--font-label, "Sora", sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-primary, #4ba3c3);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 0 0 3px rgba(75, 163, 195, 0.15);
  }

  /* Custom Select Wrapper */
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  .contact-form select {
    appearance: none;
    cursor: pointer;
  }
  .contact-form select option {
    background: #0d1b2a;
    color: #ffffff;
  }
  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.5);
    pointer-events: none;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-label, "Sora", sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0d1b2a;
    background: #ffffff;
    padding: 1rem 2.5rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .btn-submit:hover {
    background: #d8eaf2;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }
  .btn-submit:active {
    transform: translateY(0);
  }

  .response-time {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .response-time .highlight {
    color: var(--color-primary, #4ba3c3);
    font-weight: 500;
  }

  /* ══════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════ */
  @media (max-width: 1024px) {
    .matrix-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: 2.75rem;
    }
    .contact-matrix {
      padding: 4rem 0 5rem;
    }
    .form-container {
      padding: 2rem;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .form-footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-submit {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("mainContactForm") as HTMLFormElement;
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = form.querySelector(".btn-submit") as HTMLButtonElement;
        const orgText = btn.innerHTML;

        // Show loading state
        btn.innerHTML = '<span>Sending...</span>';
        btn.style.opacity = '0.7';
        btn.disabled = true;

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          const response = await fetch('/api/submit-inquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          if (!response.ok) throw new Error('Submission failed');

          // Show success state
          btn.innerHTML =
            '<span>Message Sent</span> <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          btn.style.background = "#10B981"; // Green
          btn.style.color = "#fff";
          btn.style.opacity = '1';

          setTimeout(() => {
            form.reset();
            btn.innerHTML = orgText;
            btn.style.background = "";
            btn.style.color = "";
            btn.disabled = false;
          }, 4000);

        } catch (error) {
          console.error(error);
          btn.innerHTML = '<span>Error - Try Again</span>';
          btn.style.background = "#EF4444"; // Red
          btn.style.color = "#fff";
          btn.style.opacity = '1';
          
          setTimeout(() => {
            btn.innerHTML = orgText;
            btn.style.background = "";
            btn.style.color = "";
            btn.disabled = false;
          }, 3000);
        }
      });
    }
  });
</script>

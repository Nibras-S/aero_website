---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter(p => p.id !== featuredPost.id);
const categories = ['All', ...new Set(allPosts.map(p => p.data.category))];

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function estimateReadTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}
---

<MainLayout
  title="News & Insights | Flyger Aviation Services"
  description="Expert aviation insights, company news, and industry analysis from the Flyger team."
>
  <Navbar />

  <main class="blog-page">
    <!-- ═══ HERO ═══ -->
    <section class="blog-hero">
      <div class="blog-hero__bg" aria-hidden="true"></div>
      <div class="container blog-hero__content">
        <span class="blog-hero__label">NEWS & INSIGHTS</span>
        <h1 class="blog-hero__title">The Flyger Journal.</h1>
        <p class="blog-hero__tagline">
          Expert perspectives on aviation operations, industry trends, and
          the future of flight support.
        </p>
      </div>
    </section>

    <!-- ═══ FEATURED POST ═══ -->
    {featuredPost && (
      <section class="featured-section">
        <div class="container">
          <a href={`/blog/${featuredPost.id}`} class="featured-card" id="featured-post">
            <div class="featured-card__image-wrap">
              <img loading="lazy" decoding="async"
                src={featuredPost.data.featuredImage}
                alt={featuredPost.data.title}
                class="featured-card__image"
                loading="eager"
              />
              <div class="featured-card__image-overlay"></div>
              <span class="featured-card__badge">Featured</span>
            </div>
            <div class="featured-card__body">
              <span class="featured-card__category">{featuredPost.data.category}</span>
              <h2 class="featured-card__title">{featuredPost.data.title}</h2>
              <p class="featured-card__excerpt">{featuredPost.data.excerpt}</p>
              <div class="featured-card__meta">
                <span class="featured-card__author">{featuredPost.data.author}</span>
                <span class="featured-card__separator">·</span>
                <time datetime={featuredPost.data.date.toISOString()}>
                  {formatDate(featuredPost.data.date)}
                </time>
                <span class="featured-card__separator">·</span>
                <span>{estimateReadTime(featuredPost.body || '')} min read</span>
              </div>
              <span class="featured-card__cta">
                Read Article
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- ═══ FILTER + SEARCH BAR ═══ -->
    <section class="filter-section">
      <div class="container">
        <div class="filter-bar">
          <div class="filter-pills" id="categoryFilters">
            {categories.map((cat, i) => (
              <button
                class={`filter-pill ${i === 0 ? 'active' : ''}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>
          <div class="search-box">
            <svg class="search-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              class="search-box__input"
              id="blogSearch"
              placeholder="Search articles..."
              aria-label="Search blog posts"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ BLOG GRID ═══ -->
    <section class="blog-grid-section">
      <div class="container">
        <div class="blog-grid" id="blogGrid">
          {regularPosts.map(post => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card"
              data-category={post.data.category}
              data-title={post.data.title.toLowerCase()}
            >
              <div class="blog-card__image-wrap">
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  class="blog-card__image"
                  loading="lazy"
                />
                <div class="blog-card__image-overlay"></div>
              </div>
              <div class="blog-card__body">
                <span class="blog-card__category">{post.data.category}</span>
                <h3 class="blog-card__title">{post.data.title}</h3>
                <p class="blog-card__excerpt">{post.data.excerpt}</p>
                <div class="blog-card__meta">
                  <span>{post.data.author}</span>
                  <span class="blog-card__dot">·</span>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </div>
              </div>
            </a>
          ))}
        </div>

        <p class="no-results hidden" id="noResults">
          No articles found matching your search.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hidden { display: none !important; }

  /* ══════════════════════════════════
     HERO
  ══════════════════════════════════ */
  .blog-hero {
    position: relative;
    padding: 10rem 0 5rem;
    background: #07131f;
    overflow: hidden;
  }

  .blog-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 255, 255, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 100%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  .blog-hero__content {
    position: relative;
    z-index: 2;
  }

  .blog-hero__label {
    display: inline-block;
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 1rem;
  }

  .blog-hero__title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .blog-hero__tagline {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(255, 255, 255, 0.6);
    max-width: 50ch;
    line-height: 1.6;
  }

  /* ══════════════════════════════════
     FEATURED POST
  ══════════════════════════════════ */
  .featured-section {
    background: #07131f;
    padding: 0 0 4rem;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s ease;
  }

  .featured-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .featured-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.05);
  }

  .featured-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(7, 19, 31, 0.3) 0%, transparent 100%);
  }

  .featured-card__badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    background: #ffffff;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
  }

  .featured-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem;
    gap: 0.75rem;
  }

  .featured-card__category {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .featured-card__title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .featured-card__excerpt {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-card__meta {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .featured-card__separator { opacity: 0.4; }

  .featured-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 0.5rem;
    transition: gap 0.3s ease;
  }

  .featured-card:hover .featured-card__cta {
    gap: 0.85rem;
  }

  /* ══════════════════════════════════
     FILTER BAR
  ══════════════════════════════════ */
  .filter-section {
    background: #07131f;
    padding: 0 0 3rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .filter-pills {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .filter-pills::-webkit-scrollbar { display: none; }

  .filter-pill {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .filter-pill.active {
    color: #000000;
    background: #ffffff;
    border-color: #ffffff;
    font-weight: 600;
  }

  .search-box {
    position: relative;
    width: 260px;
    flex-shrink: 0;
  }

  .search-box__icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
  }

  .search-box__input {
    width: 100%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.88rem;
    color: #ffffff;
    transition: all 0.2s;
  }

  .search-box__input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .search-box__input:focus {
    outline: none;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.12);
  }

  /* ══════════════════════════════════
     BLOG GRID
  ══════════════════════════════════ */
  .blog-grid-section {
    background: #07131f;
    padding: 0 0 8rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.35s ease;
  }

  .blog-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
  }

  .blog-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.06);
  }

  .blog-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 19, 31, 0.5) 0%, transparent 60%);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 0.6rem;
    flex: 1;
  }

  .blog-card__category {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .blog-card__title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__excerpt {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .blog-card__meta {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .blog-card__dot { opacity: 0.4; }

  .no-results {
    text-align: center;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.4);
    padding: 4rem 0;
  }

  /* ══════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════ */
  @media (max-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-card { grid-template-columns: 1fr; }
    .featured-card__body { padding: 2rem; }
  }

  @media (max-width: 768px) {
    .blog-hero { padding: 8rem 0 3rem; }
    .blog-grid { grid-template-columns: 1fr; }
    .filter-bar { flex-direction: column; align-items: stretch; }
    .search-box { width: 100%; }
  }
</style>

<script>
  function initBlogFilters() {
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.blog-card');
    const searchInput = document.getElementById('blogSearch') as HTMLInputElement;
    const noResults = document.getElementById('noResults');
    let activeCategory = 'All';

    function filterCards() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const cat = cardEl.getAttribute('data-category') || '';
        const title = cardEl.getAttribute('data-title') || '';

        const matchesCategory = activeCategory === 'All' || cat === activeCategory;
        const matchesSearch = !query || title.includes(query);

        if (matchesCategory && matchesSearch) {
          cardEl.style.display = '';
          visibleCount++;
        } else {
          cardEl.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeCategory = pill.getAttribute('data-category') || 'All';
        filterCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', filterCards);
    }
  }

  document.addEventListener('DOMContentLoaded', initBlogFilters);
  document.addEventListener('astro:page-load', initBlogFilters);
</script>

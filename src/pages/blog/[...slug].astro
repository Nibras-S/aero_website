---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get related posts (same category, exclude current)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function estimateReadTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const readTime = estimateReadTime(post.body || '');
---

<MainLayout
  title={`${post.data.title} | Flyger Aviation Blog`}
  description={post.data.excerpt}
>
  <Navbar />

  <main class="blog-post-page">
    <!-- ═══ HERO IMAGE ═══ -->
    <section class="post-hero">
      <div class="post-hero__bg">
        <img loading="lazy" decoding="async"
          src={post.data.featuredImage}
          alt={post.data.title}
          class="post-hero__image"
          loading="eager"
        />
        <div class="post-hero__overlay"></div>
      </div>
      <div class="container post-hero__content">
        <a href="/blog" class="post-hero__back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to all posts
        </a>
        <span class="post-hero__category">{post.data.category}</span>
        <h1 class="post-hero__title">{post.data.title}</h1>
        <div class="post-hero__meta">
          <span class="post-hero__author">{post.data.author}</span>
          <span class="post-hero__sep">·</span>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span class="post-hero__sep">·</span>
          <span>{readTime} min read</span>
        </div>
      </div>
    </section>

    <!-- ═══ ARTICLE BODY ═══ -->
    <article class="post-article">
      <div class="container">
        <div class="prose">
          <Content />
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag: string) => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </article>

    <!-- ═══ RELATED POSTS ═══ -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="related-section__heading">Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map(rp => (
              <a href={`/blog/${rp.id}`} class="related-card">
                <div class="related-card__image-wrap">
                  <img
                    src={rp.data.featuredImage}
                    alt={rp.data.title}
                    class="related-card__image"
                    loading="lazy"
                  />
                </div>
                <div class="related-card__body">
                  <span class="related-card__category">{rp.data.category}</span>
                  <h3 class="related-card__title">{rp.data.title}</h3>
                  <time class="related-card__date" datetime={rp.data.date.toISOString()}>
                    {formatDate(rp.data.date)}
                  </time>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</MainLayout>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ══════════════════════════════════
     POST HERO
  ══════════════════════════════════ */
  .post-hero {
    position: relative;
    min-height: 65svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .post-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .post-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .post-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(7, 19, 31, 1) 0%,
      rgba(7, 19, 31, 0.85) 40%,
      rgba(7, 19, 31, 0.3) 100%
    );
  }

  .post-hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: 4rem;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .post-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .post-hero__back:hover {
    color: #ffffff;
  }

  .post-hero__category {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #000000;
    background: #ffffff;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    border: 1px solid #ffffff;
    width: fit-content;
  }

  .post-hero__title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .post-hero__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.5);
    flex-wrap: wrap;
  }

  .post-hero__author { font-weight: 500; color: rgba(255, 255, 255, 0.7); }
  .post-hero__sep { opacity: 0.3; }

  /* ══════════════════════════════════
     ARTICLE BODY — PROSE
  ══════════════════════════════════ */
  .post-article {
    background: #07131f;
    padding: 5rem 0 4rem;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Headings */
  .prose :global(h2) {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose :global(h3) {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .prose :global(h4) {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Paragraphs */
  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  /* Links */
  .prose :global(a) {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  .prose :global(a:hover) {
    color: rgba(255, 255, 255, 0.7);
  }

  /* Lists */
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(li::marker) {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Blockquote */
  .prose :global(blockquote) {
    border-left: 3px solid #ffffff;
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: rgba(255, 255, 255, 0.7);
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Code */
  .prose :global(code) {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: #ffffff;
  }

  .prose :global(pre) {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  /* Strong & Em */
  .prose :global(strong) {
    font-weight: 600;
    color: #ffffff;
  }

  /* Table */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .prose :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .prose :global(td) {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  /* Images */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  /* HR */
  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2.5rem 0;
  }

  /* ══════════════════════════════════
     TAGS
  ══════════════════════════════════ */
  .post-tags {
    max-width: 720px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  /* ══════════════════════════════════
     RELATED POSTS
  ══════════════════════════════════ */
  .related-section {
    background: #07131f;
    padding: 0 0 8rem;
  }

  .related-section__heading {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .related-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .related-card__image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .related-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .related-card:hover .related-card__image {
    transform: scale(1.05);
  }

  .related-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-card__category {
    font-family: var(--font-label, 'Sora', sans-serif);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .related-card__title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-card__date {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.35);
  }

  /* ══════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════ */
  @media (max-width: 1024px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .post-hero { min-height: 50svh; }
    .post-hero__content { padding-bottom: 3rem; }
    .post-hero__title { font-size: 1.75rem; }
    .post-article { padding: 3rem 0; }
    .prose { font-size: 1rem; }
    .prose :global(h2) { font-size: 1.45rem; }
    .prose :global(h3) { font-size: 1.15rem; }
    .related-grid { grid-template-columns: 1fr; }
    .related-section { padding-bottom: 5rem; }
  }
</style>

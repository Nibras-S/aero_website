---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, BlogPosts, Inquiries } from 'astro:db';

const totalBlogs = (await db.select().from(BlogPosts)).length;
const inquiries = await db.select().from(Inquiries);
const unreadInquiries = inquiries.filter(i => i.status === 'New').length;
---

<AdminLayout title="Dashboard">
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.875rem; font-weight: 700; margin: 0 0 0.5rem 0;">Overview</h1>
    <p style="color: var(--muted-foreground); margin:0;">Welcome to the Flyger Administration Portal. Manage your content and clients here.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 0.875rem; font-weight: 500; margin:0;">Total Blog Posts</h3>
        <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="16" width="16" style="color: var(--muted-foreground);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      </div>
      <div style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">{totalBlogs}</div>
      <p style="font-size: 0.75rem; color: var(--muted-foreground); margin:0;">Published articles</p>
    </div>

    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 0.875rem; font-weight: 500; margin:0;">Total Inquiries</h3>
        <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="16" width="16" style="color: var(--muted-foreground);"><circle cx="12" cy="12" r="4"></circle><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg>
      </div>
      <div style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">{inquiries.length}</div>
      <p style="font-size: 0.75rem; color: var(--muted-foreground); margin:0;">Lifetime leads captured</p>
    </div>

    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 0.875rem; font-weight: 500; margin:0;">Pending Action</h3>
        <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="16" width="16" style="color: var(--muted-foreground);"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">{unreadInquiries}</div>
      <p style="font-size: 0.75rem; color: var(--muted-foreground); margin:0;">New inquiries to review</p>
    </div>

  </div>
</AdminLayout>

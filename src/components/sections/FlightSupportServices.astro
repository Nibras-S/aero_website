---
// Flight Support Services — full-screen cinematic hero + horizontal card carousel
---

<section class="fss-section">

  <!-- Full-Screen Cinematic Hero (matching screenshot) -->
  <div class="fss-hero">
    <div class="fss-hero-overlay"></div>
    <div class="fss-hero-content">
      <!-- Left: Large heading -->
      <div class="fss-hero-left">
        <h2 class="fss-heading">
          Seamless Flight<br />
          Operations, Anywhere<br />
          <span class="fss-accent">You Fly</span>
        </h2>
      </div>
      <!-- Right: Description + CTA -->
      <div class="fss-hero-right">
        <p class="fss-desc">
          End-to-end operational support designed to keep
          every flight efficient, compliant, and on schedule.
        </p>
        <a href="#contact" class="fss-cta">
          Request Flight Support
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Cards block scrolls naturally over the hero -->
  <div class="fss-cards-block">
    <ul class="fss-carousel" id="fssCarousel">

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=800&auto=format&fit=crop" alt="Flight Planning" loading="lazy" />
        <div class="fss-card-label">
          <h3>Flight Planning</h3>
          <p>Comprehensive route analysis and optimal flight plans tailored to your mission requirements.</p>
        </div>
      </li>

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1540962351504-03099e0a754b?q=80&w=800&auto=format&fit=crop" alt="Overflight & Landing Permits" loading="lazy" />
        <div class="fss-card-label">
          <h3>Overflight & Landing Permits</h3>
          <p>Rapid acquisition of global clearances ensuring uninterrupted access worldwide.</p>
        </div>
      </li>

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1587019158091-1a103c5dd17f?q=80&w=800&auto=format&fit=crop" alt="Dispatch & Coordination" loading="lazy" />
        <div class="fss-card-label">
          <h3>Dispatch & Coordination</h3>
          <p>24/7 dedicated flight dispatch providing seamless ground-to-air operational support.</p>
        </div>
      </li>

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1556388158-158ea5ccacbd?q=80&w=800&auto=format&fit=crop" alt="Slot & PPR Management" loading="lazy" />
        <div class="fss-card-label">
          <h3>Slot & PPR Management</h3>
          <p>Strategic coordination of airport slots and prior permission required approvals.</p>
        </div>
      </li>

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=800&auto=format&fit=crop" alt="Flight Monitoring" loading="lazy" />
        <div class="fss-card-label">
          <h3>Flight Monitoring</h3>
          <p>Real-time global flight tracking with proactive issue resolution at every stage.</p>
        </div>
      </li>

      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?q=80&w=800&auto=format&fit=crop" alt="Crew Support" loading="lazy" />
        <div class="fss-card-label">
          <h3>Crew Support</h3>
          <p>Premium hotel accommodations, ground transport, and full logistics for your crew.</p>
        </div>
      </li>

    </ul>
  </div>

</section>

<style>
  .fss-section {
    color: #ffffff;
  }

  /* ── Full-screen hero with fixed parallax bg ── */
  .fss-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    background-image: url('https://images.unsplash.com/photo-1474302770737-173ee21bab63?q=80&w=1800&auto=format&fit=crop');
    background-size: cover;
    background-position: center 35%;
    background-attachment: fixed;
    display: flex;
    align-items: flex-end;
  }

  /* Bottom-heavy dark gradient so text reads clearly */
  .fss-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5, 10, 20, 0.88) 0%,
      rgba(5, 10, 20, 0.5) 40%,
      rgba(5, 10, 20, 0.15) 80%,
      transparent 100%
    );
    z-index: 0;
  }

  /* Bottom-split content: heading left, CTA right */
  /* Content starts hidden, animates in on scroll */
  .fss-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2.5rem 5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
  }
  .fss-hero-content.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .fss-hero-left {
    flex: 1;
  }

  .fss-heading {
    font-size: clamp(1.9rem, 3.8vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.025em;
    color: #ffffff;
    font-family: 'Inter', 'Helvetica Neue', system-ui, sans-serif;
  }

  .fss-accent {
    color: #c8cdd4; /* soft silver-grey, not blue */
    display: block;
    font-weight: 300;
    font-style: italic;
  }

  .fss-hero-right {
    flex-shrink: 0;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    padding-bottom: 0.4rem;
  }

  .fss-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.75;
    margin: 0;
  }

  .fss-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.95);
    color: #0d1b2a;
    border: none;
    border-radius: 999px;
    padding: 0.8rem 1.8rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, transform 0.2s;
    white-space: nowrap;
  }
  .fss-cta:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }
  .fss-cta svg { transition: transform 0.2s; }
  .fss-cta:hover svg { transform: translate(2px, -2px); }

  /* ── Cards block ── */
  .fss-cards-block {
    background: #000000;
    position: relative;
    z-index: 1;
  }

  .fss-carousel {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .fss-carousel::-webkit-scrollbar { display: none; }

  .fss-card {
    flex: 0 0 25%;
    position: relative;
    height: 500px;
    overflow: hidden;
    scroll-snap-align: start;
    cursor: pointer;
    border-right: 2px solid #000;
  }

  .fss-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fss-card-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 60%, transparent 100%);
    padding: 3rem 1.6rem 1.6rem;
  }

  .fss-card-label h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
  }

  .fss-card-label p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s ease, opacity 0.45s ease, margin-top 0.45s ease;
  }

  .fss-card:hover .fss-card-label p {
    max-height: 120px;
    opacity: 1;
    margin-top: 0.6rem;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .fss-card { flex: 0 0 33.333%; }
  }

  @media (max-width: 768px) {
    .fss-hero {
      background-attachment: scroll; /* iOS fix */
      height: 85vh;
    }
    .fss-hero-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
      padding: 0 1.5rem 3.5rem;
    }
    .fss-heading { font-size: clamp(2rem, 8vw, 3rem); }
    .fss-hero-right { max-width: 100%; }
    .fss-cta { width: 100%; justify-content: center; }
    .fss-card { flex: 0 0 80vw; height: 380px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll-triggered animation
    const heroContent = document.querySelector('.fss-hero-content');
    if (heroContent) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              heroContent.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(heroContent);
    }

    // Carousel auto-scroll
    const carousel = document.getElementById('fssCarousel');
    if (!carousel) return;

    let isInteracting = false;
    carousel.addEventListener('mouseenter', () => isInteracting = true);
    carousel.addEventListener('mouseleave', () => isInteracting = false);
    carousel.addEventListener('touchstart', () => isInteracting = true, { passive: true });
    carousel.addEventListener('touchend', () => {
      setTimeout(() => isInteracting = false, 1500);
    }, { passive: true });

    setInterval(() => {
      if (!isInteracting) {
        const card = carousel.querySelector('.fss-card');
        if (!card) return;
        const cardWidth = card.clientWidth;
        if (carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 10) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
        }
      }
    }, 4500);
  });
</script>

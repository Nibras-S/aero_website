---
// Flight Support Services — horizontal image card carousel, dark premium style
---

<section class="fss-section">
  <!-- Section Header -->
  <div class="fss-header">
    <div class="fss-header-left">
      <p class="fss-eyebrow">End-to-End Operational Coordination</p>
      <h2 class="fss-title">
        We handle <em>every element</em> of<br />
        your flight, so you can focus<br />
        on your mission.
      </h2>
    </div>
    <div class="fss-header-right">
      <p class="fss-desc">
        Precision operations, global reach, and dedicated support from planning to touchdown.
        Flyger delivers seamless flight coordination at every stage.
      </p>
      <a href="#contact" class="fss-cta">
        Talk To Us
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Cards -->
  <div class="fss-carousel-wrapper">
    <ul class="fss-carousel" id="fssCarousel">

      <!-- Card 1: Flight Planning -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=800&auto=format&fit=crop" alt="Flight Planning" loading="lazy" />
        <div class="fss-card-label">
          <h3>Flight Planning</h3>
          <p>Comprehensive route analysis and optimal flight plans tailored to your mission requirements.</p>
        </div>
      </li>

      <!-- Card 2: Overflight & Landing Permits -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1540962351504-03099e0a754b?q=80&w=800&auto=format&fit=crop" alt="Overflight & Landing Permits" loading="lazy" />
        <div class="fss-card-label">
          <h3>Overflight & Landing Permits</h3>
          <p>Rapid acquisition of global clearances ensuring uninterrupted access worldwide.</p>
        </div>
      </li>

      <!-- Card 3: Dispatch & Coordination -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1587019158091-1a103c5dd17f?q=80&w=800&auto=format&fit=crop" alt="Dispatch & Coordination" loading="lazy" />
        <div class="fss-card-label">
          <h3>Dispatch & Coordination</h3>
          <p>24/7 dedicated flight dispatch providing seamless ground-to-air operational support.</p>
        </div>
      </li>

      <!-- Card 4: Slot & PPR Management -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1556388158-158ea5ccacbd?q=80&w=800&auto=format&fit=crop" alt="Slot & PPR Management" loading="lazy" />
        <div class="fss-card-label">
          <h3>Slot & PPR Management</h3>
          <p>Strategic coordination of airport slots and prior permission required approvals.</p>
        </div>
      </li>

      <!-- Card 5: Flight Monitoring -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=800&auto=format&fit=crop" alt="Flight Monitoring" loading="lazy" />
        <div class="fss-card-label">
          <h3>Flight Monitoring</h3>
          <p>Real-time global flight tracking with proactive issue resolution at every stage.</p>
        </div>
      </li>

      <!-- Card 6: Crew Support -->
      <li class="fss-card">
        <img src="https://images.unsplash.com/photo-1569154941061-e231b4732ef1?q=80&w=800&auto=format&fit=crop" alt="Crew Support" loading="lazy" />
        <div class="fss-card-label">
          <h3>Crew Support</h3>
          <p>Premium hotel accommodations, ground transport, and full logistics for your crew.</p>
        </div>
      </li>

    </ul>
  </div>
</section>

<style>
  /* ── Section ── */
  .fss-section {
    background: #000000;
    color: #ffffff;
    overflow: hidden;
    padding-bottom: 0;
  }

  /* ── Header ── */
  .fss-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 6rem 2.5rem 3.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: flex-end;
  }

  .fss-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 1.2rem;
  }

  .fss-title {
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .fss-title em {
    font-style: normal;
    color: rgba(255,255,255,0.45);
  }

  .fss-header-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  .fss-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.8;
    margin: 0;
    max-width: 480px;
  }

  .fss-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 999px;
    padding: 0.65rem 1.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    transition: background 0.25s, border-color 0.25s, color 0.25s;
  }
  .fss-cta:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.6);
    color: #ffffff;
  }
  .fss-cta svg { transition: transform 0.2s; }
  .fss-cta:hover svg { transform: translate(2px, -2px); }

  /* ── Carousel ── */
  .fss-carousel-wrapper {
    width: 100%;
  }

  .fss-carousel {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .fss-carousel::-webkit-scrollbar { display: none; }

  /* ── Cards ── */
  .fss-card {
    flex: 0 0 25%;
    position: relative;
    height: 480px;
    overflow: hidden;
    scroll-snap-align: start;
    cursor: pointer;
    border-right: 2px solid #000;
  }

  .fss-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  /* Bottom label — always visible with title, description reveals on hover */
  .fss-card-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 60%, transparent 100%);
    padding: 3rem 1.6rem 1.6rem;
  }

  .fss-card-label h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .fss-card-label p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s ease, opacity 0.45s ease, margin-top 0.45s ease;
  }

  .fss-card:hover .fss-card-label p {
    max-height: 120px;
    opacity: 1;
    margin-top: 0.6rem;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .fss-card { flex: 0 0 33.333%; }
  }

  @media (max-width: 768px) {
    .fss-header {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 4rem 1.5rem 2.5rem;
    }
    .fss-title { font-size: clamp(1.8rem, 6vw, 2.5rem); }
    .fss-card { flex: 0 0 80vw; height: 380px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('fssCarousel');
    if (!carousel) return;

    let isInteracting = false;
    carousel.addEventListener('mouseenter', () => isInteracting = true);
    carousel.addEventListener('mouseleave', () => isInteracting = false);
    carousel.addEventListener('touchstart', () => isInteracting = true, { passive: true });
    carousel.addEventListener('touchend', () => {
      setTimeout(() => isInteracting = false, 1500);
    }, { passive: true });

    setInterval(() => {
      if (!isInteracting) {
        const card = carousel.querySelector('.fss-card');
        if (!card) return;
        const cardWidth = card.clientWidth;
        if (carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 10) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
        }
      }
    }, 4500);
  });
</script>

---
// Hero Section — structure inspired by reference layout
---

<section id="hero" class="hero">
  <!-- Geometric decoration (top-right, CSS only) -->
  <div class="hero-geo" aria-hidden="true">
    <div class="geo-shape geo-1"></div>
    <div class="geo-shape geo-2"></div>
    <div class="geo-shape geo-3"></div>
    <div class="geo-shape geo-4"></div>
    <div class="geo-shape geo-5"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-headline">
      Fly High with<br/>
      <span class="hero-accent">Flyger Aviation</span>
    </h1>
    <p class="hero-sub">
      We support international operators and private clients with seamless
      trip support, fuel solutions, and expert aviation consultancy.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">Get a Quote ↗</a>
      <a href="#about" class="btn-ghost">Learn More</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 70px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 5rem 2rem;
    background: var(--bg-main);
  }

  /* ── Geometric decoration ── */
  .hero-geo {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    pointer-events: none;
  }
  .geo-shape {
    position: absolute;
    opacity: 0.12;
  }
  .geo-1 {
    width: 280px; height: 280px;
    top: -60px; right: -40px;
    background: var(--color-primary);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .geo-2 {
    width: 200px; height: 200px;
    top: 80px; right: 140px;
    background: var(--color-secondary-start);
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
    opacity: 0.1;
  }
  .geo-3 {
    width: 150px; height: 150px;
    top: 200px; right: 0;
    background: var(--color-primary);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    opacity: 0.08;
  }
  .geo-4 {
    width: 100px; height: 100px;
    top: 320px; right: 200px;
    background: var(--color-secondary-end);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    opacity: 0.15;
  }
  .geo-5 {
    width: 60px; height: 60px;
    top: 60px; right: 300px;
    background: var(--color-primary);
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
    opacity: 0.2;
  }

  /* ── Content ── */
  .hero-content {
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 14, 22, 0.55) 0%,
      rgba(8, 14, 22, 0.35) 40%,
      rgba(8, 14, 22, 0.75) 80%,
      rgba(8, 14, 22, 1) 100%
    );
  }

  /* ── Animations ── */
  @keyframes fadeUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Center Brand Typography ── */
  .hero-brand {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .hero-headline {
    font-size: clamp(2.2rem, 6vw, 5.5rem);
    font-weight: 900;
    color: var(--color-text);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
  .hero-accent {
    color: var(--color-primary);
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  /* ── Buttons ── */
  .hero-actions {
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.12em;
    line-height: 0.88;
    margin: 0 0 0.25em;
    font-family: 'Montserrat', 'Inter', system-ui, sans-serif;
    /* Slightly condensed, geometric feel matching reference */
    text-transform: uppercase;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
  }

  .hero-subtitle {
    font-size: clamp(0.75rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 2.5rem;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.4s;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;  /* Pill shape */
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.25s;
    backdrop-filter: blur(4px);
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.6s;
  }
  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.8);
    color: #ffffff;
  }

  /* ── Floating News Card ── */
  .hero-news-card {
    position: absolute;
    bottom: 7rem;
    left: 2.5rem;
    z-index: 2;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    background: rgba(10, 15, 22, 0.62);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    max-width: 420px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.8s;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 2rem;
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.25rem;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.88; }
  .btn-ghost {
  /* ── Bottom Text Columns ── */
  .hero-text-cols {
    position: absolute;
    bottom: 3rem;
    right: 2.5rem;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 700px;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 1.0s;
  }
  .hero-text-col,
  .hero-text-col-right p {
    font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    margin: 0;
  }
  .hero-text-col-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero-read-more {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    border: 1.5px solid rgba(75, 163, 195, 0.4);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: 0.25rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-name { 
      font-size: clamp(3rem, 14vw, 5rem); 
      letter-spacing: 0.08em;
    }
    .hero-subtitle {
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      margin: 0 0 2rem;
    }
    .hero-cta {
      font-size: 0.7rem;
      padding: 0.6rem 1.5rem;
    }
    .hero-news-card { display: none; }
    .hero-text-cols {
      position: relative;
      bottom: auto; right: auto;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem;
      max-width: 100%;
      margin-top: 3rem;
    }
  }
</style>

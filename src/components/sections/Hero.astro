---
// Hero Section — KiMi Aviation inspired, full-screen cinematic dark
---

<section id="hero" class="hero">
  <!-- Background video -->
  <div class="hero-bg" aria-hidden="true">
    <video class="hero-bg-img" autoplay muted loop playsinline>
      <source src="/images/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
  </div>

  <!-- Center Brand Name -->
  <div class="hero-brand">
    <h1 class="hero-name">FLYGER</h1>
    <p class="hero-subtitle">FLY HIGH WITH FLYGER</p>
    <!-- <a href="#contact" class="hero-cta">
      EXPLORE SERVICES
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a> -->
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: #ffffff;
  }

  /* ── Background Image + Overlay ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.7);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 14, 22, 0.55) 0%,
      rgba(8, 14, 22, 0.35) 40%,
      rgba(8, 14, 22, 0.75) 80%,
      rgba(8, 14, 22, 1) 100%
    );
  }

  /* ── Animations ── */
  @keyframes fadeUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Center Brand Typography ── */
  .hero-brand {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 2rem;
    margin-top: -4rem; /* Pulled up slightly, text cols are at bottom */
  }

  .hero-name {
    font-size: clamp(5rem, 18vw, 18rem);
    font-weight: 900;
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.12em;
    line-height: 0.88;
    margin: 0 0 0.25em;
    font-family: var(--font-heading);
    /* Slightly condensed, geometric feel matching reference */
    text-transform: uppercase;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
  }

  .hero-subtitle {
    font-size: clamp(0.75rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 2.5rem;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.4s;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;  /* Pill shape */
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.25s;
    backdrop-filter: blur(4px);
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.6s;
  }
  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.8);
    color: #ffffff;
  }

  /* ── Floating News Card ── */
  .hero-news-card {
    position: absolute;
    bottom: 7rem;
    left: 2.5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(10, 15, 22, 0.62);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    max-width: 420px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.8s;
  }
  .hero-news-img {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }
  .hero-news-text h3 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }
  .hero-news-text p {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }
  .hero-news-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .hero-news-link:hover { color: #ffffff; }

  /* ── Bottom Text Columns ── */
  .hero-text-cols {
    position: absolute;
    bottom: 3rem;
    right: 2.5rem;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 700px;
    opacity: 0;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 1.0s;
  }
  .hero-text-col,
  .hero-text-col-right p {
    font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    margin: 0;
  }
  .hero-text-col-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .hero-read-more:hover { color: #ffffff; }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-name { font-size: clamp(3rem, 15vw, 6rem); }
    .hero-news-card { display: none; }
    .hero-text-cols {
      position: relative;
      bottom: auto; right: auto;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem;
      max-width: 100%;
      margin-top: 3rem;
    }
  }
</style>

---
// src/components/sections/trip-support/StationRepDetails.astro
// Premium split-layout: Editorial left + Vertical timeline right
// Apple/Stripe-inspired minimal white design

const steps = [
  {
    id: "01",
    title: "On-Ground Representation",
    desc: "Dedicated personnel embedded at strategic airports worldwide.",
  },
  {
    id: "02",
    title: "Planning & Coordination",
    desc: "End-to-end operational management, from brief to execution.",
  },
  {
    id: "03",
    title: "Compliance Monitoring",
    desc: "Continuous oversight of facilities, equipment, and procedures.",
  },
  {
    id: "04",
    title: "Vendor Management",
    desc: "Curated third-party networks held to the highest standards.",
  },
  {
    id: "05",
    title: "Turnaround Operations",
    desc: "Check-in, ramp, and gate — orchestrated to the minute.",
  },
  {
    id: "06",
    title: "Permits & Slots",
    desc: "Flight permits secured and slots coordinated without delay.",
  },
  {
    id: "07",
    title: "Authority Liaison",
    desc: "Direct communication with airport authorities and partners.",
  },
  {
    id: "08",
    title: "Financial Processes",
    desc: "Billing, revenue collection, and transparent reporting.",
  },
];
---

<section class="srd" id="station-rep-details">
  <div class="srd__inner">

    <!-- LEFT: Editorial Content -->
    <div class="srd__editorial">
      <span class="srd__eyebrow">Station Representation</span>
      <h2 class="srd__heading">
        Precision on<br />the ground.
      </h2>
      <p class="srd__body">
        Every operation depends on what happens between landing and takeoff. 
        We position experienced teams at key airports to manage every detail — 
        from compliance and vendor oversight to turnaround execution and 
        financial coordination.
      </p>
      <p class="srd__body srd__body--muted">
        Your operations, extended. Our people, on the ground.
      </p>
    </div>

    <!-- RIGHT: Vertical Timeline -->
    <div class="srd__timeline" id="srd-timeline">
      <div class="timeline-line" aria-hidden="true">
        <div class="timeline-line__progress" id="timeline-progress"></div>
      </div>
      {steps.map((step, i) => (
        <div class="timeline-step" data-step={i}>
          <div class="timeline-step__marker">
            <span class="timeline-step__number">{step.id}</span>
          </div>
          <div class="timeline-step__content">
            <h3 class="timeline-step__title">{step.title}</h3>
            <p class="timeline-step__desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ========================================================
     STATION REP — PREMIUM SPLIT LAYOUT
     ======================================================== */
  .srd {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
    position: relative;
    overflow: hidden;
  }

  /* Subtle accent glow */
  .srd::before {
    content: '';
    position: absolute;
    top: 20%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(75, 163, 195, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .srd::after {
    content: '';
    position: absolute;
    bottom: 10%;
    right: -5%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(75, 163, 195, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .srd__inner {
    display: flex;
    align-items: flex-start;
    gap: 6rem;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* ========================================================
     LEFT — EDITORIAL
     ======================================================== */
  .srd__editorial {
    flex: 1;
    max-width: 460px;
    position: sticky;
    top: 50%;
    transform: translateY(-50%);
  }

  .srd__eyebrow {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary, #4BA3C3);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: srdFadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) 200ms forwards;
  }

  .srd__heading {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #0D1B2A;
    margin: 0 0 2rem;
    opacity: 0;
    animation: srdFadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) 350ms forwards;
  }

  .srd__body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: #4a5568;
    margin: 0 0 1.25rem;
    opacity: 0;
    animation: srdFadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) 500ms forwards;
  }

  .srd__body--muted {
    font-style: italic;
    color: #94a3b8;
    font-size: 0.95rem;
    animation-delay: 600ms;
  }

  @keyframes srdFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ========================================================
     RIGHT — VERTICAL TIMELINE
     ======================================================== */
  .srd__timeline {
    flex: 1;
    max-width: 520px;
    position: relative;
    padding-left: 2.5rem;
  }

  /* The thin connecting line */
  .timeline-line {
    position: absolute;
    left: 0.6rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: #e2e8f0;
    border-radius: 1px;
  }

  .timeline-line__progress {
    width: 100%;
    height: 0%;
    background: var(--color-primary, #4BA3C3);
    border-radius: 1px;
    transition: height 0.1s linear;
    will-change: height;
  }

  /* Individual step */
  .timeline-step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
    position: relative;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-step:last-child {
    padding-bottom: 0;
  }

  .timeline-step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Number marker */
  .timeline-step__marker {
    position: absolute;
    left: -2.5rem;
    top: 0;
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-step__number {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.05em;
    transition: color 0.4s ease;
  }

  .timeline-step.is-visible .timeline-step__number {
    color: var(--color-primary, #4BA3C3);
  }

  /* Step content */
  .timeline-step__content {
    flex: 1;
    padding-top: 0;
  }

  .timeline-step__title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #0D1B2A;
    margin: 0 0 0.35rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .timeline-step__desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #718096;
    line-height: 1.6;
    margin: 0;
  }

  /* ========================================================
     RESPONSIVE
     ======================================================== */
  @media (max-width: 900px) {
    .srd {
      padding: 4rem 1.5rem;
      min-height: auto;
    }

    .srd__inner {
      flex-direction: column;
      gap: 3.5rem;
    }

    .srd__editorial {
      position: relative;
      top: auto;
      transform: none;
      max-width: 100%;
    }

    .srd__timeline {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .srd {
      padding: 3rem 1.25rem;
    }

    .srd__heading {
      font-size: 2.25rem;
    }

    .timeline-step {
      padding-bottom: 2rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .srd__eyebrow, .srd__heading, .srd__body, .timeline-step {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const timeline = document.getElementById('srd-timeline');
    const progressBar = document.getElementById('timeline-progress');
    const steps = document.querySelectorAll('.timeline-step');
    if (!timeline || !progressBar || steps.length === 0) return;

    // IntersectionObserver for individual step fade-in
    const stepObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
          }
        });
      },
      { rootMargin: '-10% 0px -10% 0px', threshold: 0.2 }
    );

    steps.forEach((step) => stepObserver.observe(step));

    // Scroll-driven timeline progress line
    const handleScroll = () => {
      const rect = timeline.getBoundingClientRect();
      const vh = window.innerHeight;

      // Calculate how far through the timeline we've scrolled
      const start = rect.top - vh * 0.6;
      const end = rect.bottom - vh * 0.4;
      const total = end - start;

      let progress = 0;
      if (start < 0) {
        progress = Math.abs(start) / total;
      }
      progress = Math.max(0, Math.min(1, progress));
      progressBar.style.height = `${progress * 100}%`;
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    handleScroll();
  });
</script>

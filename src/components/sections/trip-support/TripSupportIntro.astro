---
// Flight Support Section (formerly TripSupportIntro)
// Re-designed with premium horizontal image cards
---

<section id="flight-support" class="fs-section">
  <div class="fs-container">
    <div class="fs-header">
      <h2 class="fs-title">FLIGHT SUPPORT</h2>
      <p class="fs-subtitle">End-to-End Operational Coordination</p>
    </div>
  </div>

  <div class="fs-carousel-wrapper">
    <ul class="fs-carousel" id="fsCarousel">
      <!-- Card 1 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=600&auto=format&fit=crop" alt="Flight Planning" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Flight Planning</h3>
          <p class="fs-card-desc">Comprehensive route analysis and optimal flight plans tailored to your specific requirements.</p>
        </div>
      </li>
      <!-- Card 2 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1540962351504-03099e0a754b?q=80&w=600&auto=format&fit=crop" alt="Overflight & Landing Permits" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Overflight & Landing Permits</h3>
          <p class="fs-card-desc">Rapid acquisition of global clearances and permits to ensure uninterrupted journeys worldwide.</p>
        </div>
      </li>
      <!-- Card 3 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1587019158091-1a103c5dd17f?q=80&w=600&auto=format&fit=crop" alt="Dispatch & Coordination" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Dispatch & Coordination</h3>
          <p class="fs-card-desc">24/7 dedicated flight dispatch providing seamless ground-to-air operational support.</p>
        </div>
      </li>
      <!-- Card 4 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1556388158-158ea5ccacbd?q=80&w=600&auto=format&fit=crop" alt="Slot & PPR Management" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Slot & PPR Management</h3>
          <p class="fs-card-desc">Strategic coordination of airport slots and prior permission required (PPR) approvals.</p>
        </div>
      </li>
      <!-- Card 5 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=600&auto=format&fit=crop" alt="Flight Monitoring" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Flight Monitoring</h3>
          <p class="fs-card-desc">Real-time global flight tracking and proactive issue resolution at every stage of the trip.</p>
        </div>
      </li>
      <!-- Card 6 -->
      <li class="fs-card">
        <img src="https://images.unsplash.com/photo-1569154941061-e231b4732ef1?q=80&w=600&auto=format&fit=crop" alt="Crew Support" loading="lazy" />
        <div class="fs-card-overlay">
          <h3>Crew Support</h3>
          <p class="fs-card-desc">Premium hotel accommodations, ground transportation, and logistics for your crew.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<!-- Modal Backdrop -->
<div class="modal-backdrop" id="trip-modal-backdrop" aria-hidden="true"></div>

<!-- Modal Form -->
<dialog class="modal" id="trip-modal" aria-labelledby="modal-title">
  <div class="modal__inner">
    <div class="modal__header">
      <div>
        <h2 id="modal-title" class="modal__title">Request Trip Support</h2>
        <p class="modal__subtitle">
          Our operations team will respond within 2 hours.
        </p>
      </div>
      <button
        type="button"
        class="modal__close"
        id="close-trip-modal"
        aria-label="Close dialog"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form class="modal__form" id="trip-form" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="trip-name" class="form-label"
            >Full Name <span class="req">*</span></label
          >
          <input
            type="text"
            id="trip-name"
            name="name"
            class="form-input"
            placeholder="e.g. James Rodriguez"
            required
            autocomplete="name"
          />
        </div>
        <div class="form-group">
          <label for="trip-company" class="form-label">Company</label>
          <input
            type="text"
            id="trip-company"
            name="company"
            class="form-input"
            placeholder="e.g. Meridian Aviation"
            autocomplete="organization"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="trip-email" class="form-label"
          >Email Address <span class="req">*</span></label
        >
        <input
          type="email"
          id="trip-email"
          name="email"
          class="form-input"
          placeholder="e.g. ops@meridian.aero"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="trip-details" class="form-label">Trip Details</label>
        <textarea
          id="trip-details"
          name="details"
          class="form-input form-textarea"
          rows="4"
          placeholder="Aircraft type, route, dates, number of pax, special requirements..."
        ></textarea>
      </div>

      <button type="submit" class="modal__submit" id="submit-trip">
        <span class="submit-text">Submit Request</span>
        <span class="submit-loader" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
            ></path>
          </svg>
        </span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M22 2L11 13"></path>
          <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
        </svg>
      </button>
    </form>

    <!-- Success -->
    <div class="modal__success" id="trip-success" hidden>
      <div class="success-icon">
        <svg
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M8 12l3 3 5-5"></path>
        </svg>
      </div>
      <h3>Request Submitted</h3>
      <p>Our operations team will reach out shortly.</p>
      <button type="button" class="modal__submit" id="close-success"
        >Done</button
      >
    </div>
  </div>
</dialog>

<style>
  .fs-section {
    background: #090d14; /* Blends perfectly with AboutIntro */
    padding: 6rem 0 6rem;
    color: #ffffff;
    overflow: hidden;
  }

  .fs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 3.5rem;
  }

  .fs-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fs-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300; /* Thinner, like AboutIntro statement */
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
    color: rgba(255, 255, 255, 0.85); /* Slightly softer silver */
  }

  .fs-subtitle {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    color: #94a3b8;
    font-weight: 300;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .fs-carousel-wrapper {
    width: 100%;
  }

  .fs-carousel {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0 2rem 3rem max(2rem, calc((100vw - 1400px) / 2 + 2rem));
    scroll-padding-left: max(2rem, calc((100vw - 1400px) / 2 + 2rem));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  /* Hide scrollbar for a seamless look */
  .fs-carousel::-webkit-scrollbar {
    display: none;
  }
  .fs-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .fs-card {
    flex: 0 0 calc(85vw - 2rem);
    max-width: 320px;
    height: 400px;
    position: relative;
    border-radius: 0; /* Sharp corners per user request */
    overflow: hidden;
    scroll-snap-align: start;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    cursor: pointer;
  }

  .fs-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fs-card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    /* Reduced opacity background */
    background: rgba(0, 0, 0, 0.60); 
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem; /* Smaller, tighter padding */
  }

  .fs-card-overlay h3 {
    color: #ffffff;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .fs-card-desc {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.4s ease, margin-top 0.4s ease;
  }

  .fs-card:hover .fs-card-desc {
    max-height: 150px;
    opacity: 1;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .fs-card {
      height: 460px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('fsCarousel');
    if (!carousel) return;

    let isInteracting = false;
    
    // Pause auto-scroll on interaction
    carousel.addEventListener('mouseenter', () => isInteracting = true);
    carousel.addEventListener('mouseleave', () => isInteracting = false);
    carousel.addEventListener('touchstart', () => isInteracting = true, {passive: true});
    carousel.addEventListener('touchend', () => {
      setTimeout(() => isInteracting = false, 1500);
    }, {passive: true});

    // Simple Auto Scroll Logic
    setInterval(() => {
      if (!isInteracting) {
        // Calculate width of one card + its gap
        const firstCard = carousel.querySelector('.fs-card');
        if (!firstCard) return;
        
        const cardWidth = firstCard.clientWidth + 24; // 1.5rem gap = 24px
        
        // If we reached the end, snap back to 0
        if (carousel.scrollLeft >= (carousel.scrollWidth - carousel.clientWidth - 50)) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          // Scroll dynamically to the next card
          carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
        }
      }
    }, 4000); // Slides every 4 seconds
  });
</script>

---
// src/components/sections/trip-support/FlygerCRM.astro
// Bento Grid — Apple-inspired white layout showcasing CRM value
// No mockups, no AI images — pure typography + metrics
---

<section class="crm" id="flyger-crm">
  <div class="crm__container">

    <!-- Header -->
    <div class="crm__header">
      <h2 class="crm__heading">Built for aviation.<br />Designed for clarity.</h2>
      <p class="crm__sub">
        Our purpose-built CRM puts every operational and financial detail 
        in one place — so nothing falls through the cracks.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="bento">

      <!-- Large: Real-time proforma -->
      <div class="bento__cell bento__cell--wide" data-bento>
        <div class="bento__header-wrap">
          <div class="bento__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3 class="bento__title">Real-Time Proforma</h3>
        </div>
        <p class="bento__desc">Cost estimates generated the moment a trip is confirmed. No waiting, no follow-ups.</p>
        <span class="bento__metric" data-count="3">0<span class="bento__unit">sec</span></span>
        <span class="bento__metric-label">Average generation time</span>
      </div>

      <!-- Tall: Invoicing -->
      <div class="bento__cell bento__cell--tall" data-bento>
        <div class="bento__header-wrap">
          <div class="bento__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><text x="12" y="16" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="800" font-size="9" fill="currentColor" stroke="none">AED</text></svg>
          </div>
          <h3 class="bento__title">Instant Invoicing</h3>
        </div>
        <p class="bento__desc">Invoices delivered immediately after turnaround — eliminating delays and uncertainty.</p>
        <div class="bento__visual-stack">
          <div class="invoice-line"><span class="il-dot il-dot--done"></span><span class="il-text">Trip completed</span><span class="il-check">✓</span></div>
          <div class="invoice-line"><span class="il-dot il-dot--done"></span><span class="il-text">Invoice generated</span><span class="il-check">✓</span></div>
          <div class="invoice-line"><span class="il-dot il-dot--done"></span><span class="il-text">Client notified</span><span class="il-check">✓</span></div>
        </div>
      </div>

      <!-- Regular: Coordination -->
      <div class="bento__cell" data-bento>
        <div class="bento__header-wrap">
          <div class="bento__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="bento__title">One Platform</h3>
        </div>
        <p class="bento__desc">Ops, clients, and ground teams — all connected through a single thread.</p>
      </div>

      <!-- Regular: Visibility -->
      <div class="bento__cell" data-bento>
        <div class="bento__header-wrap">
          <div class="bento__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="bento__title">Full Visibility</h3>
        </div>
        <p class="bento__desc">Track costs, revenue, and operational status — in real time, from anywhere.</p>
      </div>

      <!-- Wide bottom: The big number -->
      <div class="bento__cell bento__cell--wide bento__cell--accent" data-bento>
        <div class="bento__big-number">
          <span class="bento__metric" data-count="100">0</span><span class="bento__unit-lg">%</span>
        </div>
        <div class="bento__accent-text">
          <h3 class="bento__title bento__title--white">Complete Transparency</h3>
          <p class="bento__desc bento__desc--white">Every cost, every approval, every document — visible to you at every stage of the operation.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .crm {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 4.7rem 2.5rem 3rem;
    background: #ffffff;
    position: relative;
  }

  .crm__container {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
  }

  /* ---- Header ---- */
  .crm__header {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .crm__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #0D1B2A;
    margin: 0 0 0.6rem;
  }

  .crm__sub {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6b7280;
    max-width: 520px;
    margin: 0;
  }

  /* ---- Bento Grid ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: auto;
    gap: 0.6rem;
  }

  .bento__cell {
    background: #f9fafb;
    border: 1px solid #f0f0f0;
    border-radius: 0.5rem;
    padding: 1.25rem 1.4rem;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s ease;
  }

  .bento__cell.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .bento__cell:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }

  .bento__cell--wide {
    grid-column: span 2;
  }

  .bento__cell--tall {
    grid-row: span 2;
  }

  /* Accent cell (dark) */
  .bento__cell--accent {
    background: #0D1B2A;
    border-color: #1a2d42;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .bento__header-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .bento__icon {
    width: 34px;
    height: 34px;
    border-radius: 0.35rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary, #4BA3C3);
    flex-shrink: 0;
  }

  .bento__cell--accent .bento__icon {
    background: rgba(75, 163, 195, 0.15);
    border-color: rgba(75, 163, 195, 0.25);
  }

  .bento__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: #0D1B2A;
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }
  
  .bento__header-wrap .bento__title {
    margin: 0;
  }

  .bento__title--white { color: #ffffff; }

  .bento__desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: #6b7280;
    line-height: 1.5;
    margin: 0;
  }

  .bento__desc--white { color: rgba(255,255,255,0.55); }

  /* Metric */
  .bento__metric {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-primary, #4BA3C3);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 0.75rem;
  }

  .bento__unit {
    font-size: 1.5rem;
    font-weight: 600;
    color: #9ca3af;
    margin-left: 2px;
  }

  .bento__metric-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #9ca3af;
    margin-top: 0.25rem;
    display: block;
  }

  /* Big number in accent cell */
  .bento__big-number {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
  }

  .bento__big-number .bento__metric {
    font-size: 3.5rem;
    color: #ffffff;
    margin-top: 0;
  }

  .bento__unit-lg {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-primary, #4BA3C3);
    margin-left: 2px;
  }

  .bento__accent-text {
    flex: 1;
  }

  /* Invoice checklist in tall cell */
  .bento__visual-stack {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .invoice-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.2rem;
  }

  .il-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .il-dot--done { background: #22c55e; }

  .il-text {
    flex: 1;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: #374151;
  }

  .il-check {
    font-size: 0.7rem;
    color: #22c55e;
    font-weight: 700;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .crm {
      padding: 2.5rem 1.5rem;
      min-height: auto;
    }

    .bento {
      grid-template-columns: 1fr 1fr;
    }

    .bento__cell--tall {
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .crm {
      padding: 2rem 1.25rem;
    }

    .bento {
      grid-template-columns: 1fr;
    }

    .bento__cell--wide {
      grid-column: span 1;
    }

    .bento__cell--accent {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .bento__big-number .bento__metric {
      font-size: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento__cell {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Staggered reveal for bento cells
    const cells = document.querySelectorAll('[data-bento]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' }
    );

    cells.forEach((cell, i) => {
      (cell as HTMLElement).style.transitionDelay = `${i * 100}ms`;
      observer.observe(cell);
    });

    // Count-up animation for metrics
    const countElements = document.querySelectorAll('[data-count]');
    const countObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.count || '0', 10);
            let current = 0;
            const duration = 1500;
            const stepTime = 30;
            const steps = duration / stepTime;
            const increment = target / steps;

            const timer = setInterval(() => {
              current += increment;
              if (current >= target) {
                current = target;
                clearInterval(timer);
              }
              // Keep the unit span intact
              const unitSpan = el.querySelector('.bento__unit, .bento__unit-lg');
              const unitHTML = unitSpan ? unitSpan.outerHTML : '';
              el.innerHTML = Math.round(current) + unitHTML;
            }, stepTime);

            countObserver.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );

    countElements.forEach((el) => countObserver.observe(el));
  });
</script>

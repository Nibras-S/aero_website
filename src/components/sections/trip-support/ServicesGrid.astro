</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll-Jacking Animation Logic
    const initScrollEngine = () => {
      const container = document.getElementById('services-pin-container');
      const rows = document.querySelectorAll('.service-row');
      const dots = document.querySelectorAll('.progress-dot');
      if (!container || rows.length === 0) return;

      const numItems = rows.length;

      const handleScroll = () => {
        // Calculate scroll bounds
        const rect = container.getBoundingClientRect();
        
        // Progress starts exactly when the container hits the top of viewport
        const trackHeight = rect.height - window.innerHeight; 
        
        let progress = 0;
        if (rect.top <= 0) {
          progress = Math.abs(rect.top) / trackHeight;
        }

        progress = Math.max(0, Math.min(1, progress));

        // Determine active index
        let activeIndex = Math.floor(progress * numItems);
        if (activeIndex >= numItems) activeIndex = numItems - 1; 

        // Update classes
        rows.forEach((row, i) => {
          row.classList.remove('is-active', 'is-past');
          const btn = row.querySelector('[data-service-btn]');
          
          if (i === activeIndex) {
            row.classList.add('is-active');
            if(btn) btn.setAttribute('tabindex', '0');
          } else if (i < activeIndex) {
            row.classList.add('is-past'); 
            if(btn) btn.setAttribute('tabindex', '-1'); 
          } else {
             if(btn) btn.setAttribute('tabindex', '-1'); 
          }
        });

        const progressAirplane = document.getElementById('progress-airplane');
        if (progressAirplane) {
          // Use translateY for butter-smooth movement (progress * 300px track)
          const yPos = progress * 300; 
          progressAirplane.style.transform = `translateX(-50%) translateY(${yPos}px) rotate(180deg)`;
        }
      };

      // requestAnimationFrame optimization
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScroll();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
      
      // Initialize
      handleScroll();
    };

    initScrollEngine();
  });
</script>
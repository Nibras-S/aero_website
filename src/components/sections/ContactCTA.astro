---
// ContactCTA Section
// Refactored to a bold, typography-driven layout with centered multi-contact box
---

<section id="contact" class="cta-section">
  <!-- Huge typography background layer -->
  <div class="cta-typography" aria-hidden="true">
    <div class="typo-line">GET</div>
    <div class="typo-line">IN</div>
    <div class="typo-line">TOUCH</div>
  </div>

  <!-- Foreground contact box overlapping the center -->
  <div class="cta-overlay-box">
    <div class="contact-group">
      <span class="box-label">EMAIL US AT</span>
      <a href="mailto:ops@flyger.com" class="box-contact">ops@flyger.com</a>
    </div>

    <div class="contact-divider"></div>

    <div class="contact-group">
      <span class="box-label">AOG / 24 HRS</span>
      <a href="tel:+18005553594" class="box-contact">+971-522554468</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    width: 100%;
    min-height: 100svh; /* Changed to full viewport size */
    padding: 2rem 0;
    background-color: #111111; /* Very dark, sophisticated black */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Massive Background Typography dictates the height */
  .cta-typography {
    position: relative;
    width: 100%;
    text-align: center;
    pointer-events: none;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .typo-line {
    font-size: clamp(6.5rem, 16vw, 22rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 0.85; /* Tight vertical spacing */
    text-transform: uppercase;
    letter-spacing: -0.04em;
    margin: 0;
    white-space: nowrap;
    user-select: none;
  }

  /* Overlay Box Floats Perfectly in Center */
  .cta-overlay-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;

    /* Subtle glassy effect for readability while keeping "IN" visible */
    background-color: rgba(20, 20, 20, 0.15); /* Very low opacity */
    backdrop-filter: blur(8px); /* Mild blur */
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.05); /* Extremely subtle border */
    border-radius: 24px; /* Soft rounded corners for the glass */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); /* Soft shadow */

    padding: 3.5rem 5rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    width: max-content;
    max-width: 90vw;
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .contact-divider {
    width: 1px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .box-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .box-contact {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 400;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .box-contact:hover,
  .box-contact:focus-visible {
    color: var(--color-primary, #4ba3c3);
    outline: none;
  }

  /* Responsive iPad & Mobile Adjustments */
  @media (max-width: 900px) {
    .cta-section {
      padding: 6rem 0;
    }

    .typo-line {
      font-size: clamp(5rem, 21vw, 12rem);
    }

    .cta-overlay-box {
      padding: 2.5rem 3rem;
      gap: 2.5rem;
      /* Add classy blur to separate from dense background text on smaller devices */
      background-color: rgba(26, 26, 26, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .contact-divider {
      height: 50px;
    }
  }

  @media (max-width: 600px) {
    .cta-section {
      flex-direction: column;
      padding: 4rem 1.5rem;
      align-items: stretch;
      min-height: auto;
    }

    .cta-typography {
      position: relative;
      margin-bottom: 2.5rem;
    }

    .typo-line {
      font-size: clamp(4.5rem, 18vw, 6rem);
      line-height: 0.95;
    }

    .cta-overlay-box {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      flex-direction: column;
      padding: 2.5rem 1.5rem;
      gap: 1.5rem;
      width: 100%;
      max-width: 100%;
    }

    .contact-divider {
      width: 60px;
      height: 1px;
    }

    .box-contact {
      font-size: 1.35rem;
    }
  }
</style>

---
// FuelHero — Pro cinematic hero with auto-expanding pill animation
---

<div class="fh-root">

  <!-- Words flank the pill on white bg -->
  <span class="fh-word fh-left">Reliable</span>
  <span class="fh-word fh-right">Global</span>

  <!-- Pill wrapper: fills root, centers pill without flex-sibling issues -->
  <div class="fh-pill-wrap">
    <div class="fh-pill">
      <img
        src="/images/flight.jpg"
        alt="Flyger Aviation fuel operations"
        class="fh-pill-img"
      />
      <!-- Gradient overlay builds up as pill expands -->
      <div class="fh-overlay" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Hero text fades in after expansion — z-index above everything -->
  <div class="fh-text">
    <div class="fh-text-inner">
      <h1 class="fh-headline">
        Fueling Aviation<br/>Worldwide.
      </h1>
      <p class="fh-sub">
        Premium jet fuel supply with seamless coordination<br/>
        across 180+ countries and thousands of airports.
      </p>
      <div class="fh-actions">
        <a href="#contact" class="fh-cta-ghost">Contact Our Team ↗</a>
      </div>
    </div>
  </div>

</div>

<style>
  /* ── Root ── */
  .fh-root {
    --color-primary: #ffffff;
    --color-text: #111827;
    --bg-main: #ffffff;
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 620px;
    background: var(--bg-main);
    overflow: hidden;            /* critical: clips pill at 100% without scrollbar bleed */
  }

  /* ── Flanking words ── */
  .fh-word {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    font-size: clamp(2.8rem, 7.5vw, 7rem);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    animation:
      fh-word-in  0.4s cubic-bezier(0.22,1,0.36,1) 0.1s both,
      fh-word-out-left 0.8s cubic-bezier(0.76,0,0.24,1) 1.2s forwards;
  }
  .fh-right {
    animation:
      fh-word-in  0.4s cubic-bezier(0.22,1,0.36,1) 0.1s both,
      fh-word-out-right 0.8s cubic-bezier(0.76,0,0.24,1) 1.2s forwards;
  }
  .fh-left  { left:  clamp(1.5rem, 6vw, 5rem); }
  .fh-right { right: clamp(1.5rem, 6vw, 5rem); }

  @keyframes fh-word-in  { from { opacity:0 } to { opacity:1 } }
  
  /* Slide words completely off-screen */
  @keyframes fh-word-out-left {
    to { transform: translate(calc(-100% - clamp(1.5rem, 6vw, 5rem)), -50%); opacity: 0; pointer-events:none; }
  }
  @keyframes fh-word-out-right {
    to { transform: translate(calc(100% + clamp(1.5rem, 6vw, 5rem)), -50%); opacity: 0; pointer-events:none; }
  }

  /* ── Pill wrap — full-area centering container ── */
  .fh-pill-wrap {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* ── Pill — only width/height/radius animate ── */
  .fh-pill {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 999px;
    width:  clamp(200px, 22vw, 300px);
    height: clamp(200px, 22vw, 300px);
    box-shadow: 0 32px 80px rgba(0,0,0,0.22);
    /* Continuous easing curve without sticking */
    animation: fh-expand 2s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    will-change: width, height, border-radius;
  }

  @keyframes fh-expand {
    0% {
      width:  clamp(200px, 22vw, 300px);
      height: clamp(200px, 22vw, 300px);
      border-radius: 999px;
    }
    /* Smooth transition straight to full screen, keeping it a smooth ellipse shape through the middle */
    50% {
      width: clamp(500px, 60vw, 800px);
      height: clamp(400px, 50vw, 600px);
      border-radius: 200px;
    }
    100% {
      width:  100%;
      height: 100svh;
      border-radius: 0;
    }
  }

  .fh-pill-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    display: block;
    /* Subtle Ken Burns after reveal */
    animation: fh-zoom 12s ease-in-out 2.2s both;
  }
  @keyframes fh-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  /* Gradient overlay builds inside the pill */
  .fh-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 55%, transparent 100%);
    opacity: 0;
    animation: fh-overlay-in 0.8s ease-out 1.7s forwards;
  }
  @keyframes fh-overlay-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Hero text ── */
  .fh-text {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
    pointer-events: none;
    opacity: 0;
    animation: fh-text-in 0.8s cubic-bezier(0.22,1,0.36,1) 2s forwards;
  }
  .fh-text a,
  .fh-text button { pointer-events: auto; }

  @keyframes fh-text-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  .fh-text-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem clamp(2rem, 8vw, 8rem);
    max-width: 660px;
  }

  .fh-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255,255,255,0.75);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .fh-eyebrow-dot {
    width: 7px; height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(255,255,255,0.3);
    animation: dot-pulse 2s ease-in-out infinite;
  }
  @keyframes dot-pulse {
    0%,100% { box-shadow: 0 0 0 3px rgba(255,255,255,0.3); }
    50%      { box-shadow: 0 0 0 6px rgba(255,255,255,0);   }
  }

  .fh-headline {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.0;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 24px rgba(0,0,0,0.4);
  }

  .fh-sub {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(255,255,255,0.72);
    line-height: 1.8;
    margin-bottom: 2.25rem;
    letter-spacing: 0.01em;
  }

  .fh-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .fh-cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2rem;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 0.35rem;
    letter-spacing: 0.01em;
    transition: opacity 0.2s, transform 0.2s;
    box-shadow: 0 4px 20px rgba(255,255,255,0.3);
  }
  .fh-cta-primary:hover { opacity: 0.9; transform: translateY(-2px); }

  .fh-cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.75rem;
    border: 1.5px solid rgba(255,255,255,0.4);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 0.35rem;
    transition: border-color 0.2s, background 0.2s;
    backdrop-filter: blur(4px);
  }
  .fh-cta-ghost:hover {
    border-color: rgba(255,255,255,0.8);
    background: rgba(255,255,255,0.08);
  }

  /* ── Bottom stat bar ── */
  .fh-stat-bar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 1.5rem clamp(2rem, 8vw, 8rem);
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .fh-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0 2.5rem 0 0;
    flex: 1;
  }
  .fh-stat strong {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .fh-stat span {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }
  .fh-stat-sep {
    width: 1px;
    height: 2rem;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
    margin: 0 2.5rem 0 0;
  }

  /* ── Mobile ── */
  @media (max-width: 680px) {
    .fh-word { font-size: clamp(1.8rem, 8vw, 3rem); }
    .fh-left  { left: 1rem;  }
    .fh-right { right: 1rem; }
    .fh-text-inner { padding: 5rem 1.5rem 2rem; max-width: 100%; }
    .fh-stat-bar { padding: 1rem 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .fh-stat-sep { display: none; }
    .fh-stat { padding: 0; flex: 0 0 40%; }

    @keyframes fh-expand {
      0%   { width: 52vw;  height: 52vw;  border-radius: 999px; }
      30%  { width: 90vw;  height: 52vw;  border-radius: 80px;  }
      65%  { width: 100%;  height: 62vw;  border-radius: 20px;  }
      100% { width: 100%;  height: 100svh; border-radius: 0;    }
    }
  }
</style>

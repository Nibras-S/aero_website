---
// Leadership Section
---

<section class="leadership">
  <div class="container">
    <div class="header">
      <h2 class="heading">Our <span>Leadership</span></h2>
      <p class="subtitle">Guided by decades of aviation expertise and a vision for the future.</p>
    </div>
    
    <div class="grid">
      <!-- Placeholder Team Members -->
      <div class="member">
        <div class="avatar"></div>
        <h3 class="name">John Doe</h3>
        <p class="role">Chief Executive Officer</p>
      </div>

      <div class="member">
        <div class="avatar"></div>
        <h3 class="name">Jane Smith</h3>
        <p class="role">Head of Global Ops</p>
      </div>

      <div class="member">
        <div class="avatar"></div>
        <h3 class="name">Michael Lee</h3>
        <p class="role">VP of Trip Support</p>
      </div>
    </div>
  </div>
</section>

<style>
  .leadership {
    padding: 6rem 2rem;
    background: var(--bg-main);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .heading {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .heading span {
    color: var(--color-primary);
  }
  .subtitle {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
  }
  .member {
    text-align: center;
  }
  .avatar {
    width: 200px;
    height: 200px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: rgba(75, 163, 195, 0.1);
    border: 1px solid rgba(75, 163, 195, 0.2);
  }
  .name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .role {
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }
</style>

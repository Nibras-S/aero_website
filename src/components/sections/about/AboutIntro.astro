---
// AboutIntro Section
// Shared between the Home Page and the top of the About Us Page
---

<section id="about" class="about-intro">
  <div class="container">
    <div class="content">
      <p class="overline">Who We Are</p>
      <h2 class="heading">Elevating Global Aviation Standards</h2>
      <p class="description">
        Flyger Aviation Services is a premier provider of comprehensive flight support and aviation consultancy. 
        With a robust global network, we deliver seamless, reliable, and customized solutions to international operators and private clients.
      </p>
      <a href="/about" class="btn-ghost">Discover Our Story →</a>
    </div>
    <div class="image-wrapper">
      <div class="placeholder-img" aria-label="Aviation operations representation"></div>
    </div>
  </div>
</section>

<style>
  .about-intro {
    padding: 1.5rem 2rem 3rem;
    background: var(--bg-main);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .overline {
    color: var(--color-primary);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .heading {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .description {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    border: 1.5px solid rgba(75, 163, 195, 0.4);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: 0.25rem;
    transition: all 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  
  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(75, 163, 195, 0.05);
  }
  .placeholder-img {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(75,163,195,0.1), rgba(13,33,55,0.05));
    border: 1px solid rgba(75, 163, 195, 0.1);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .image-wrapper {
      order: -1;
    }
  }
</style>

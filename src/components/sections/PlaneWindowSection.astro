---
// Plane Window Section — full-screen, black bg, centred window with video inside
---

<section class="pw-section">

  <!-- Centred window stack -->
  <div class="pw-window-wrap">
    <!-- video plays inside the transparent window opening -->
    <video class="pw-video" autoplay muted loop playsinline>
      <source src="/images/hero-video.mp4" type="video/mp4" />
    </video>
    <!-- window frame on top — must have transparent centre -->
    <img src="/images/plane-window.webp" alt="" class="pw-frame" />
  </div>

  <!-- Text overlaid on the left -->
  <div class="pw-text">
    <span class="pw-tag">THE FLYGER EXPERIENCE</span>
    <h2 class="pw-heading">
      Be part of<br /><em>the journey</em>
    </h2>
    <p class="pw-body">
      Every flight is more than a destination — it's a new perspective.
      From ground support to the sky above, Flyger puts you in the seat
      that matters most.
    </p>
    <a href="#contact" class="pw-link">
      Explore our services
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>

</section>

<style>
  /* ── Section shell ── */
  .pw-section {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #000000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Window + video stack ── */
  .pw-window-wrap {
    position: relative;
    /* fill the full height, let width scale naturally */
    height: 100%;
    /* keep original image aspect – 3:4 is typical plane-window portrait */
    aspect-ratio: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* video sits behind the frame, filling the same box */
  .pw-video {
    position: absolute;
    /* nudge it to sit inside the oval only — adjust as needed */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56%;          /* approximate oval width relative to frame */
    height: 60%;         /* approximate oval height relative to frame */
    object-fit: cover;
    border-radius: 50%;  /* soft oval clipping fallback */
    z-index: 1;
  }

  /* Frame image sits on top of video */
  .pw-frame {
    position: relative;
    z-index: 2;
    height: 100%;
    width: auto;
    object-fit: contain;
    pointer-events: none;
    display: block;
  }

  /* ── Left-side text overlay ── */
  .pw-text {
    position: absolute;
    left: clamp(2.5rem, 7vw, 7rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 380px;
  }

  .pw-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  .pw-heading {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    font-family: 'Montserrat', 'Inter', system-ui, sans-serif;
  }
  .pw-heading em {
    font-style: italic;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.72);
  }

  .pw-body {
    font-size: clamp(0.8rem, 1.1vw, 0.9rem);
    color: rgba(255, 255, 255, 0.42);
    line-height: 1.8;
    margin: 0;
  }

  .pw-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    margin-top: 0.25rem;
    transition: color 0.2s;
  }
  .pw-link:hover { color: #ffffff; }
  .pw-link svg { transition: transform 0.2s; }
  .pw-link:hover svg { transform: translateX(4px); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .pw-text {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      padding: 2.5rem 1.5rem 0;
      max-width: 100%;
      text-align: center;
      align-items: center;
    }
    .pw-section {
      height: auto;
      flex-direction: column;
      padding-bottom: 3rem;
    }
    .pw-window-wrap {
      height: 65vw;
      width: auto;
    }
  }
</style>

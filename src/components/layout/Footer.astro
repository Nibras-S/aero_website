---
// Footer — Jetvia inspired layout component
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- 1. Brand & Intro -->
      <div class="footer-col footer-brand-col">
        <p class="footer-desc">
          Fly High With Flyger — where every journey begins with precision,
          reliable aviation support, and unforgettable experiences across the
          skies.
        </p>
        <div class="footer-social" style="display: none;"></div>
      </div>

      <!-- 2. Company -->
      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="#about">About Us</a></li>
          <li><a href="/consultancy">Our Services</a></li>
          <li><a href="/fuel">Fuel Services</a></li>
        </ul>
      </div>

      <!-- 3. Resources -->
      <div class="footer-col">
        <h3>Resources</h3>
        <ul>
          <li><a href="/blog">News & Insights</a></li>
        </ul>
      </div>

      <!-- 4. Contact Us -->
      <div class="footer-col">
        <h3>Contact</h3>
        <ul>
          <li><a href="tel:+971501234567">+971 50 123 4567</a></li>
          <li><a href="mailto:ops@flyger.aero">ops@flyger.aero</a></li>
          <li class="contact-address-item">
            DSO-IFZA, IFZA Properties,<br />Dubai Silicon Oasis,<br
            />Dubai, UAE
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-legal">
        <span>Aviation Partners</span>
        <span>AeroTech Systems</span>
      </div>
      <p>&copy; 2025 Flyger Aviation Services. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #111111; /* Very dark/black base */
    color: #e5e7eb;
    padding-top: 6rem;
    padding-bottom: 2rem;
    font-family: "Inter", system-ui, sans-serif;
    overflow: hidden;
  }

  /* Giant Faded Text like Jetvia */
  .footer-giant-text {
    position: absolute;
    bottom: -0.15em;
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(8rem, 25vw, 25rem); /* Massive responsive scaling */
    font-weight: 800;
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.04); /* Just a faint trace on black */
    text-transform: uppercase;
    letter-spacing: -0.05em;
    pointer-events: none;
    z-index: 0;
    width: 100%;
    text-align: center;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.06),
      transparent
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-container {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05); /* Faint dark border */
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col h3 {
    font-size: 1rem;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-col li {
    font-size: 0.9rem;
    color: #9ca3af;
    display: flex;
    align-items: flex-start;
    font-weight: 300;
    line-height: 1.6;
  }

  .footer-col a {
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #ffffff;
  }

  /* ── 1. Brand & Intro ── */
  .footer-desc {
    font-size: 1rem;
    color: #d1d5db;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 380px;
    font-weight: 300;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }
  .footer-social a {
    color: #9ca3af;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition:
      transform 0.2s,
      background 0.2s,
      color 0.2s;
  }
  .footer-social a:hover {
    color: #ffffff;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  /* ── 4. Contact Column Specific ── */
  .contact-address-item {
    display: block;
    max-width: 200px;
    margin-top: 0.5rem;
  }

  /* ── Bottom Bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 0 1rem;
    font-size: 0.85rem;
    color: #9ca3af;
    font-weight: 300;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-legal {
    display: flex;
    gap: 2.5rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-giant-text {
      font-size: 18vw;
      bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-col:last-child {
      grid-column: span 2;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .footer-legal {
      flex-direction: column;
      gap: 0.5rem;
    }
    .footer-container {
      padding: 0 2rem;
    }
  }
</style>

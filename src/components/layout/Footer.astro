---
// Footer — layout component
---

<footer class="site-footer">
  <div class="footer-bg-clouds"></div>

  <div class="footer-container">
    <!-- Top Grid -->
    <div class="footer-grid">
      
      <!-- 1. Brand & Newsletter -->
      <div class="footer-col footer-brand-col">
        <div class="footer-logo">
          FLYGER
        </div>
        <p class="footer-desc">
          Delivering reliable aviation support with precision and care.
        </p>

        <form class="footer-newsletter">
          <input type="email" placeholder="Enter your email" required aria-label="Email address" />
          <button type="submit" aria-label="Subscribe">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>

        <div class="footer-social">
          <p>Follow Us on</p>
          <div class="social-icons">
            <a href="#" aria-label="TikTok">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
            </a>
            <a href="#" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            <a href="#" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 2. Navigation -->
      <div class="footer-col">
        <h3>Navigation</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="#about">About Us</a></li>
          <li><a href="/fuel">Capabilities</a></li>
          <li><a href="#resources">Resources</a></li>
        </ul>
      </div>

      <!-- 3. Locations -->
      <div class="footer-col">
        <h3>Locations</h3>
        <ul>
          <li>Riyadh</li>
          <li>Jeddah</li>
          <li>Jubail</li>
        </ul>
        <p class="footer-subtext">Regional & international<br/>support on request</p>
      </div>

      <!-- 4. Contact Us -->
      <div class="footer-col footer-contact-col">
        <h3>Contact us</h3>
        <ul>
          <li>
            <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>info@flyger.aero</span>
          </li>
          <li class="contact-address-item">
            <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span>6443 Al Imam Saud Ibn Faysal Rd, Al Malqa, Riyadh 13522</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>&copy; 2025 Flyger. All rights reserved.</p>
      <div class="footer-legal">
        <a href="#terms">Terms &amp; Conditions</a>
        <a href="#privacy">Privacy Policy</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #ffffff; /* pure white base */
    color: #1a1a1a;
    padding-top: 6rem; /* Reduced from 10rem to be smaller */
    font-family: var(--font-body);
    overflow: hidden;
  }

  /* Cloud Image Background fading to white */
  .footer-bg-clouds {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: url('/images/flight.jpg');
    background-size: cover;
    background-position: center top;
    opacity: 0.25; /* Soft, ethereal look */
    z-index: 0;
    pointer-events: none;
    /* Fade the image cleanly into the white background below it */
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
  }

  .footer-container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 3rem; /* Reduced from 5rem */
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-col li {
    font-size: 0.9rem;
    color: #4b5563;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-col a {
    color: #4b5563;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--color-primary, #4BA3C3);
  }

  /* ── 1. Brand & Newsletter ── */
  .footer-logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #111827;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .footer-desc {
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 280px;
  }

  .footer-newsletter {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 0.75rem;
    padding: 0.25rem 0.25rem 0.25rem 1rem;
    max-width: 320px;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(8px);
  }
  .footer-newsletter input {
    background: transparent;
    border: none;
    outline: none;
    flex: 1;
    font-size: 0.9rem;
    color: #111827;
    padding: 0.5rem 0;
  }
  .footer-newsletter input::placeholder {
    color: #9ca3af;
  }
  .footer-newsletter button {
    background: var(--color-primary, #4BA3C3); /* Turquoise accent from reference */
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .footer-newsletter button:hover {
    transform: scale(1.05);
  }

  .footer-social p {
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.75rem;
  }

  .social-icons {
    display: flex;
    gap: 1rem;
  }
  .social-icons a {
    color: #111827;
    transition: transform 0.2s, color 0.2s;
  }
  .social-icons a:hover {
    color: var(--color-primary, #4BA3C3);
    transform: translateY(-2px);
  }

  /* ── 3. Locations ── */
  .footer-subtext {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: #6b7280;
    line-height: 1.5;
  }

  /* ── 4. Contact Us ── */
  .contact-icon {
    flex-shrink: 0;
    color: #6b7280;
    margin-top: 0.1rem;
  }
  .contact-address-item {
    align-items: flex-start !important;
  }
  .contact-address-item span {
    line-height: 1.5;
  }

  /* ── Bottom Bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #111827;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal {
    display: flex;
    gap: 2rem;
  }
  .footer-legal a {
    color: #111827;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover {
    color: var(--color-primary, #4BA3C3);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-legal {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

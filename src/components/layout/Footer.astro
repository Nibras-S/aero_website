---
// Footer — Jetvia inspired layout component
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- 1. Brand & Intro -->
      <div class="footer-col footer-brand-col">
        <p class="footer-desc">
          Fly High With Flyger — where every journey begins with precision,
          reliable aviation support, and unforgettable experiences across the
          skies.
        </p>
        <div class="footer-social">
          <a href="#" aria-label="X">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path
                d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg
            >
          </a>
          <a href="#" aria-label="Facebook">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path></svg
            >
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path><rect x="2" y="9" width="4" height="12"></rect><circle
                cx="4"
                cy="4"
                r="2"></circle></svg
            >
          </a>
          <a href="#" aria-label="Instagram">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
            >
          </a>
        </div>
      </div>

      <!-- 2. Company -->
      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="#about">About Us</a></li>
          <li><a href="/consultancy">Our Services</a></li>
          <li><a href="/fuel">Fuel Services</a></li>
          <li><a href="#careers">Careers</a></li>
          <li><a href="#awards">Awards & Recognition</a></li>
        </ul>
      </div>

      <!-- 3. Resources -->
      <div class="footer-col">
        <h3>Resources</h3>
        <ul>
          <li><a href="#news">News & Insights</a></li>
          <li><a href="#media">Press & Media</a></li>
          <li><a href="#privacy">Privacy Policy</a></li>
          <li><a href="#terms">Terms of Use</a></li>
          <li><a href="#support">Support</a></li>
        </ul>
      </div>

      <!-- 4. Contact Us -->
      <div class="footer-col">
        <h3>Contact</h3>
        <ul>
          <li>+971 50 123 4567</li>
          <li>ops@flyger.aero</li>
          <li class="contact-address-item">
            6443 Al Imam Saud Ibn Faysal Rd,<br />Al Malqa, Riyadh 13522,<br
            />Saudi Arabia
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-legal">
        <span>Aviation Partners</span>
        <span>AeroTech Systems</span>
      </div>
      <p>&copy; 2025 Flyger Aviation Services. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #111111; /* Very dark/black base */
    color: #e5e7eb;
    padding-top: 6rem;
    padding-bottom: 2rem;
    font-family: "Inter", system-ui, sans-serif;
    overflow: hidden;
  }

  /* Giant Faded Text like Jetvia */
  .footer-giant-text {
    position: absolute;
    bottom: -0.15em;
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(8rem, 25vw, 25rem); /* Massive responsive scaling */
    font-weight: 800;
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.04); /* Just a faint trace on black */
    text-transform: uppercase;
    letter-spacing: -0.05em;
    pointer-events: none;
    z-index: 0;
    width: 100%;
    text-align: center;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.06),
      transparent
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-container {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05); /* Faint dark border */
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col h3 {
    font-size: 1rem;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-col li {
    font-size: 0.9rem;
    color: #9ca3af;
    display: flex;
    align-items: flex-start;
    font-weight: 300;
    line-height: 1.6;
  }

  .footer-col a {
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #ffffff;
  }

  /* ── 1. Brand & Intro ── */
  .footer-desc {
    font-size: 1rem;
    color: #d1d5db;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 380px;
    font-weight: 300;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }
  .footer-social a {
    color: #9ca3af;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition:
      transform 0.2s,
      background 0.2s,
      color 0.2s;
  }
  .footer-social a:hover {
    color: #ffffff;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  /* ── 4. Contact Column Specific ── */
  .contact-address-item {
    display: block;
    max-width: 200px;
    margin-top: 0.5rem;
  }

  /* ── Bottom Bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 0 1rem;
    font-size: 0.85rem;
    color: #9ca3af;
    font-weight: 300;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-legal {
    display: flex;
    gap: 2.5rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-giant-text {
      font-size: 18vw;
      bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-col:last-child {
      grid-column: span 2;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .footer-legal {
      flex-direction: column;
      gap: 0.5rem;
    }
    .footer-container {
      padding: 0 2rem;
    }
  }
</style>

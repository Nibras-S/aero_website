---
// Navbar — KiMi Aviation style transparent overlay layout
---

<header id="navbar" class="navbar">
  <div class="nav-inner">
    <!-- Left: Social icons -->
    <div class="nav-left">
      <div class="nav-social" style="display: none;"></div>
    </div>

    <!-- Center: Logo -->
    <a href="/" class="nav-logo" aria-label="Flyger Aviation Services">
      <img src="/images/logo.png" alt="Flyger Aviation" class="nav-logo-img" />
    </a>

    <!-- Right: Nav links + Menu -->
    <div class="nav-right">
      <nav class="nav-links" aria-label="Main navigation">
        <button
          class="nav-link"
          id="trip-support-btn"
          style="display: flex; align-items: center; gap: 0.25rem; background: none; border: none; cursor: pointer; font-family: inherit;"
        >
          Trip Support
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg
          >
        </button>
        <a href="/fuel" class="nav-link">Fuel</a>
        <a href="/consultancy" class="nav-link">Consultancy</a>
        <a href="/contact-us" class="nav-cta">Contact Us</a>
      </nav>
      <button
        class="nav-menu-btn"
        id="hamburger-btn"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="menu-icon">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Sleek 2-Column Mobile Menu Dropdown -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-grid">
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Company</span>
            <a href="/about" class="mobile-link">About Us</a>
            <a
              href="/contact-us"
              class="mobile-link"
              style="color: var(--color-primary); font-weight: 600;"
              >Contact Us</a
            >
          </div>
        </div>
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Solutions</span>
            <div class="mobile-dropdown desktop-hidden-dropdown">
              <button
                class="mobile-link icon-link"
                id="mobile-trip-support-btn"
                aria-expanded="false"
                style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; font-family: inherit; justify-content: space-between;"
              >
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <span>Trip Support</span>
                </div>
                <svg
                  class="mobile-dropdown-icon"
                  id="mobile-trip-support-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><polyline points="6 9 12 15 18 9"></polyline></svg
                >
              </button>

              <div
                class="mobile-dropdown-content"
                id="mobile-trip-support-menu"
              >
                <a
                  href="/trip-support"
                  class="mobile-sublink"
                  style="color: var(--color-primary); font-weight: 600;"
                  >Overview ↗</a
                >
                <a href="/services/trip-planning" class="mobile-sublink"
                  >Trip Planning</a
                >
                <a href="/services/flight-permits" class="mobile-sublink"
                  >Flight Permits</a
                >
                <a href="/services/dispatch" class="mobile-sublink"
                  >Dispatch & Ops</a
                >
                <a href="/services/supervisors" class="mobile-sublink"
                  >Ground Supervisors</a
                >
                <a
                  href="/services/station-representation"
                  class="mobile-sublink">Station Representation</a
                >
                <a href="/services/executive-concierge" class="mobile-sublink"
                  >Executive Concierge</a
                >
                <a href="/services/diversion-support" class="mobile-sublink"
                  >Diversion Support</a
                >
                <a href="/services/flyger-crm" class="mobile-sublink"
                  >Flyger CRM</a
                >
              </div>
            </div>
            <a href="/fuel" class="mobile-link">Fuel</a>
            <a href="/consultancy" class="mobile-link">Consultancy</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Mega Menu for Desktop Trip Support -->
  <div class="mega-menu" id="mega-menu" aria-hidden="true">
    <div class="mega-menu-inner">
      <div class="mega-header">
        <div>
          <span class="mega-title">Trip Support</span>
          <p class="mega-desc">
            Comprehensive operational excellence worldwide.
          </p>
        </div>
        <a href="/trip-support" class="mega-cta">Overview ↗</a>
      </div>
      <div class="mega-grid">
        <div class="mega-col">
          <span class="mega-heading">Flight Operations</span>
          <a href="/services/trip-planning" class="mega-link">Trip Planning</a>
          <a href="/services/flight-permits" class="mega-link">Flight Permits</a
          >
          <a href="/services/dispatch" class="mega-link">Dispatch & Ops</a>
        </div>
        <div class="mega-col">
          <span class="mega-heading">On Ground</span>
          <a href="/services/supervisors" class="mega-link"
            >Ground Supervisors</a
          >
          <a href="/services/station-representation" class="mega-link"
            >Station Representation</a
          >
        </div>
        <div class="mega-col">
          <span class="mega-heading">Premium Support</span>
          <a href="/services/executive-concierge" class="mega-link"
            >Executive Concierge</a
          >
          <a href="/services/diversion-support" class="mega-link"
            >Diversion Support</a
          >
          <a href="/services/flyger-crm" class="mega-link">Flyger CRM</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    /* Transparent on hero, gets darkened by JS on scroll */
    background: transparent;
    transition:
      background 0.4s ease,
      backdrop-filter 0.4s ease;
  }
  .navbar.scrolled,
  .navbar.menu-open {
    background: rgba(6, 10, 18, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .navbar.menu-open {
    border-bottom: none; /* Seamless flow into mobile menu */
  }

  .nav-inner {
    max-width: 100%;
    padding: 0 2.5rem;
    height: 95px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Left ── */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }

  .nav-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-social-link {
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }
  .nav-social-link:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  /* ── Center Logo ── */
  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-logo-img {
    height: 75px;
    width: auto;
    object-fit: contain;
    transition: opacity 0.2s;
    filter: brightness(0) invert(1);
  }
  .nav-logo:hover .nav-logo-img {
    opacity: 0.85;
  }

  /* ── Right ── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: flex-end;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: #ffffff;
  }

  /* ── Desktop Mega Menu ── */
  .mega-menu {
    position: fixed;
    top: 95px; /* right below navbar */
    left: 0;
    width: 100%;
    background: rgba(6, 10, 18, 0.85); /* Matches navbar exactly */
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    z-index: 199;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    padding-bottom: 3rem;
  }
  .mega-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
  }
  .mega-menu-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2.5rem 0 2.5rem;
    display: flex;
    gap: 4rem;
  }
  .mega-header {
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mega-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    font-family: var(--font-heading, "Plus Jakarta Sans", sans-serif);
    display: block;
    margin-bottom: 0.5rem;
  }
  .mega-desc {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }
  .mega-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mega-cta:hover {
    color: #ffffff;
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    flex: 1;
  }
  .mega-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .mega-heading {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .mega-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mega-link:hover {
    color: #ffffff;
  }

  .nav-cta {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: #ffffff;
    color: #0d1b2a;
    border-color: #ffffff;
  }

  /* MENU button */
  .nav-menu-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .nav-menu-btn:hover {
    color: #ffffff;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: all 0.3s;
  }
  .nav-menu-btn.open .menu-icon span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav-menu-btn.open .menu-icon span:nth-child(2) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ── Mobile Menu Dropdown ── */
  .mobile-menu {
    position: fixed;
    top: 95px; /* Drops directly right below the navbar */
    left: 0;
    width: 100%;
    background: rgba(
      6,
      10,
      18,
      0.85
    ); /* EXACT match to navbar scrolled background */
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    z-index: 199;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    border-radius: 0 0 24px 24px;
    padding-bottom: 2rem;
  }
  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
  }
  .mobile-menu-inner {
    max-width: 700px;
    width: 100%;
    padding: 2rem 2.5rem 0 2.5rem;
    margin: 0 auto;
  }
  .mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .mobile-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mobile-heading {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .mobile-link {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mobile-link:hover {
    color: #ffffff;
  }
  .icon-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Mobile nested dropdown */
  .mobile-dropdown {
    display: flex;
    flex-direction: column;
  }
  .mobile-dropdown-content {
    display: none;
    flex-direction: column;
    gap: 0.95rem;
    padding-left: 2.35rem; /* align with text beside icon */
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
  }
  .mobile-dropdown-content.open {
    display: flex;
  }
  .mobile-dropdown-icon {
    transition: transform 0.3s ease;
    opacity: 0.5;
  }
  .mobile-dropdown-icon.open {
    transform: rotate(180deg);
  }
  .mobile-sublink {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mobile-sublink:hover {
    color: #ffffff;
  }

  /* Responsive */
  @media (min-width: 901px) {
    .desktop-hidden-dropdown {
      display: none !important;
    }
  }
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .nav-social {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .nav-inner {
      padding: 0 1.5rem;
    }
    .mobile-menu-inner {
      padding: 1.5rem 1.5rem 0 1.5rem;
    }
    .mobile-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  const btn = document.getElementById("hamburger-btn");
  const menu = document.getElementById("mobile-menu");
  const navbar = document.getElementById("navbar");

  const megaBtn = document.getElementById("trip-support-btn");
  const megaMenu = document.getElementById("mega-menu");

  const mobileTripSupportBtn = document.getElementById(
    "mobile-trip-support-btn",
  );
  const mobileTripSupportMenu = document.getElementById(
    "mobile-trip-support-menu",
  );
  const mobileTripSupportIcon = document.getElementById(
    "mobile-trip-support-icon",
  );

  // Toggle mobile menu
  btn?.addEventListener("click", () => {
    const isOpen = btn.classList.toggle("open");
    menu?.classList.toggle("open", isOpen);
    navbar?.classList.toggle("menu-open", isOpen); // Force navbar background
    btn.setAttribute("aria-expanded", String(isOpen));
    menu?.setAttribute("aria-hidden", String(!isOpen));
    // Close mega if auto-open
    if (megaMenu?.classList.contains("open")) {
      megaMenu.classList.remove("open");
      megaMenu.setAttribute("aria-hidden", "true");
    }
  });

  // Toggle Mobile Nested Dropdown
  mobileTripSupportBtn?.addEventListener("click", (e) => {
    e.stopPropagation(); // prevent other clicks
    const isOpen = mobileTripSupportMenu?.classList.toggle("open");
    mobileTripSupportIcon?.classList.toggle("open", isOpen);
    mobileTripSupportBtn.setAttribute("aria-expanded", String(isOpen));
  });

  // Toggle Mega Menu (Desktop)
  megaBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = megaMenu?.classList.toggle("open");
    navbar?.classList.toggle("menu-open", isOpen); // Force navbar background
    megaMenu?.setAttribute("aria-hidden", String(!isOpen));

    // Close mobile menu if open
    if (menu?.classList.contains("open")) {
      btn?.classList.remove("open");
      menu.classList.remove("open");
      navbar?.classList.remove("menu-open");
      btn?.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    }
  });

  // Close mega menu on clicking outside
  document.addEventListener("click", (e) => {
    if (
      megaMenu?.classList.contains("open") &&
      !megaMenu.contains(e.target as Node) &&
      e.target !== megaBtn
    ) {
      megaMenu.classList.remove("open");
      navbar?.classList.remove("menu-open");
      megaMenu.setAttribute("aria-hidden", "true");
    }
  });

  // Close on link click
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      btn?.classList.remove("open");
      menu.classList.remove("open");
      navbar?.classList.remove("menu-open");
      btn?.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    });
  });

  megaMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      megaMenu.classList.remove("open");
      navbar?.classList.remove("menu-open");
      megaMenu.setAttribute("aria-hidden", "true");
    });
  });

  // Scroll: add .scrolled class when past viewport
  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 50) {
      navbar.classList.add("scrolled");
    } else {
      navbar.classList.remove("scrolled");
    }
  }
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();
</script>

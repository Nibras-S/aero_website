---
// Navbar — KiMi Aviation style transparent overlay layout
---

<header id="navbar" class="navbar">
  <div class="nav-inner">

    <!-- Left: Social icons -->
    <div class="nav-left">
      <div class="nav-social">
        <!-- Instagram -->
        <a href="#" aria-label="Instagram" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <!-- LinkedIn -->
        <a href="#" aria-label="LinkedIn" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <!-- Email -->
        <a href="mailto:info@flyger.aero" aria-label="Email" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Center: Logo -->
    <a href="/" class="nav-logo" aria-label="Flyger Aviation Services">
      <span class="logo-word">FLYGER</span>
      <span class="logo-sub">AVIATION SERVICES</span>
    </a>

    <!-- Right: Nav links + Menu -->
    <div class="nav-right">
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/trip-support" class="nav-link">Trip Support</a>
        <a href="/fuel" class="nav-link">Fuel</a>
        <a href="/consultancy" class="nav-link">Consultancy</a>
      </nav>
      <button class="nav-menu-btn" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <span class="menu-icon">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

  </div>

  <!-- Sleek 2-Column Mobile Menu Dropdown -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-grid">
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Company</span>
            <a href="/about" class="mobile-link">About Us</a>
            <a href="/company-profile" class="mobile-link">Company Profile</a>
            <a href="#careers" class="mobile-link">Careers</a>
          </div>
          <div class="mobile-section" style="margin-top: 1.5rem;">
            <span class="mobile-heading">Careers</span>
            <a href="#careers" class="mobile-link">Join our team</a>
          </div>
        </div>
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Solutions</span>
            <a href="/trip-support" class="mobile-link icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              <span>Trip Support</span>
            </a>
            <a href="/fuel" class="mobile-link icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
              <span>Fuel</span>
            </a>
            <a href="/consultancy" class="mobile-link icon-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
              <span>Consultancy</span>
            </a>
          </div>
          <div class="mobile-section" style="margin-top: 1.5rem;">
            <span class="mobile-heading">Contact Us</span>
            <a href="#contact" class="mobile-link">Get in touch</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    /* Transparent on hero, gets darkened by JS on scroll */
    background: transparent;
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }
  .navbar.scrolled {
    background: rgba(6, 10, 18, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .nav-inner {
    max-width: 100%;
    padding: 0 2.5rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Left ── */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }



  .nav-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-social-link {
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }
  .nav-social-link:hover { color: rgba(255,255,255,0.9); }

  /* ── Center Logo ── */
  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .logo-word {
    font-size: 1.2rem;
    font-weight: 900;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
  }
  .logo-sub {
    font-size: 0.5rem;
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  /* ── Right ── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: flex-end;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-link {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover { color: #ffffff; }

  /* MENU button */
  .nav-menu-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.75);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .nav-menu-btn:hover { color: #ffffff; }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: all 0.3s;
  }
  .nav-menu-btn.open .menu-icon span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav-menu-btn.open .menu-icon span:nth-child(2) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ── Mobile Menu Dropdown ── */
  .mobile-menu {
    position: fixed;
    top: 72px; /* Drops directly right below the navbar */
    left: 0;
    width: 100%;
    background: #111111; /* Clean pitch-black structural background */
    z-index: 199;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border-radius: 0 0 24px 24px;
    padding-bottom: 2rem;
  }
  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
  }
  .mobile-menu-inner {
    max-width: 700px;
    width: 100%;
    padding: 2rem 2.5rem 0 2.5rem;
    margin: 0 auto;
  }
  .mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .mobile-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mobile-heading {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .mobile-link {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mobile-link:hover { color: #ffffff; }
  .icon-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-social { display: none; }
  }
  @media (max-width: 600px) {
    .nav-inner { padding: 0 1.5rem; }
    .mobile-menu-inner { padding: 1.5rem 1.5rem 0 1.5rem; }
    .mobile-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');

  // Toggle mobile menu
  btn?.addEventListener('click', () => {
    const isOpen = btn.classList.toggle('open');
    menu?.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn?.classList.remove('open');
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });

  // Scroll: add .scrolled class when past viewport
  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

---
// Navbar — layout component with CTA + mobile hamburger & Dropdowns
---

<header id="navbar">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Flyger Aviation Services">
      <span class="logo-accent">FLYGER</span>
      <span class="logo-sub">AVIATION<br/>SERVICES</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="nav-links" aria-label="Main navigation">
      
      <!-- Company Dropdown -->
      <div class="nav-dropdown">
        <button class="dropdown-toggle" aria-expanded="false">
          Company
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="dropdown-menu">
          <a href="/about">About Us</a>
          <a href="#company-profile">Company Profile</a>
          <a href="#careers">Careers</a>
        </div>
      </div>

      <!-- Main Links -->
      <a href="/trip-support" class="nav-link">Trip Support</a>
      <a href="#fuel" class="nav-link">Fuel</a>
      <a href="#consultancy" class="nav-link">Consultancy</a>

    </nav>

    <!-- Right: CTA + Hamburger -->
    <div class="nav-right">
      <a href="#contact" class="nav-cta">
        Get a Quote
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <button class="hamburger" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      
      <div class="mobile-grid">
        <!-- Left Column -->
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Company</span>
            <a href="/about" class="mobile-link">About Us</a>
            <a href="#company-profile" class="mobile-link">Company Profile</a>
            <a href="#careers" class="mobile-link">Careers</a>
          </div>
          
          <div class="mobile-section">
            <span class="mobile-heading">Careers</span>
            <a href="#careers" class="mobile-link">Join our team</a>
          </div>
        </div>

        <!-- Right Column -->
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Solutions</span>
            
            <a href="/trip-support" class="mobile-link-icon">
              <span class="icon-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
              </span>
              Trip Support
            </a>
            
            <a href="#fuel" class="mobile-link-icon">
              <span class="icon-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
              </span>
              Fuel
            </a>
            
            <a href="#consultancy" class="mobile-link-icon">
              <span class="icon-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
              </span>
              Consultancy
            </a>
          </div>
          
          <div class="mobile-section">
            <span class="mobile-heading" style="margin-top: 1rem;">Contact Us</span>
            <a href="#contact" class="mobile-link">Get in touch</a>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(240, 248, 255, 0.97);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(75, 163, 195, 0.15);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-accent {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }
  .logo-sub {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Desktop nav links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--color-primary);
  }

  /* Desktop Dropdowns */
  .nav-dropdown {
    position: relative;
    padding: 1.5rem 0;
  }
  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .dropdown-toggle svg {
    transition: transform 0.2s;
  }
  .nav-dropdown:hover .dropdown-toggle {
    color: var(--color-primary);
  }
  .nav-dropdown:hover .dropdown-toggle svg {
    transform: rotate(180deg);
  }
  
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(15px);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    border: 1px solid rgba(75, 163, 195, 0.15);
    border-radius: 0.75rem;
    padding: 0.75rem;
    min-width: 200px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    transform: translateX(-50%) translateY(-5px);
    pointer-events: all;
  }
  .dropdown-menu a {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .dropdown-menu a:hover {
    background: rgba(75, 163, 195, 0.08);
    color: var(--color-primary);
  }

  /* Right side */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.25rem;
    border: 1.5px solid var(--color-primary);
    border-radius: 0.25rem;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }
  .nav-cta:hover {
    background: var(--color-primary);
    color: white;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all 0.3s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 70px;
    left: 0;
    width: 100%;
    /* Dark near-black background matching the reference */
    background: #111111; 
    padding: 2.5rem 1.5rem;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    overflow-y: auto;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  .mobile-menu.open {
    clip-path: inset(0 0 0 0);
    pointer-events: all;
  }
  .mobile-menu-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .mobile-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mobile-heading {
    /* Bold white heading exactly like reference */
    color: #FFFFFF;
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .mobile-link {
    /* Muted grey color exactly like reference */
    color: #A0AAB2;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mobile-link:hover { color: #FFFFFF; }
  
  .mobile-link-icon {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #A0AAB2;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .mobile-link-icon:hover { color: #FFFFFF; }
  
  .icon-box {
    width: 32px;
    height: 32px;
    background: #1E1E1E; /* Subdued grey box */
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary); /* Use primary color for the icon */
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-inner {
      padding: 0 1.5rem;
      gap: 1rem;
    }
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .mobile-menu { 
      display: block; 
      height: auto;
      max-height: calc(100dvh - 70px);
      border-bottom-left-radius: 1.5rem;
      border-bottom-right-radius: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .nav-inner {
      padding: 0 1rem;
      gap: 0.5rem;
    }
    
    .nav-cta {
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
    }
    
    .nav-cta svg {
      width: 12px;
      height: 12px;
    }

    .logo-accent {
      font-size: 1.25rem;
    }
    
    .logo-sub {
      font-size: 0.5rem;
    }

    /* Optional: fallback to 1 column on extremely small phones, but 2 col fits fine usually */
    .mobile-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = btn.classList.toggle('open');
    menu?.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn?.classList.remove('open');
      menu.classList.remove('open');
    });
  });
</script>

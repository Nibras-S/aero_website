---
// Navbar — KiMi Aviation style transparent overlay layout
---

<header id="navbar" class="navbar">
  <div class="nav-inner">

    <!-- Left: CTA Button + Social icons -->
    <div class="nav-left">
      <a href="#contact" class="nav-cta-pill">
        GET A QUOTE
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <div class="nav-social">
        <!-- Instagram -->
        <a href="#" aria-label="Instagram" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <!-- LinkedIn -->
        <a href="#" aria-label="LinkedIn" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <!-- Email -->
        <a href="mailto:info@flyger.aero" aria-label="Email" class="nav-social-link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Center: Logo -->
    <a href="/" class="nav-logo" aria-label="Flyger Aviation Services">
      <span class="logo-word">FLYGER</span>
      <span class="logo-sub">AVIATION SERVICES</span>
    </a>

    <!-- Right: Nav links + Menu -->
    <div class="nav-right">
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/trip-support" class="nav-link">Trip Support</a>
        <a href="/fuel" class="nav-link">Fuel</a>
        <a href="#consultancy" class="nav-link">Consultancy</a>
      </nav>
      <button class="nav-menu-btn" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
        MENU
        <span class="menu-icon">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

  </div>

  <!-- Full-screen Dark Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-grid">
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Company</span>
            <a href="/about" class="mobile-link">About Us</a>
            <a href="#careers" class="mobile-link">Careers</a>
          </div>
        </div>
        <div class="mobile-col">
          <div class="mobile-section">
            <span class="mobile-heading">Solutions</span>
            <a href="/trip-support" class="mobile-link">Trip Support</a>
            <a href="/fuel" class="mobile-link">Fuel</a>
            <a href="#consultancy" class="mobile-link">Consultancy</a>
          </div>
          <div class="mobile-section">
            <span class="mobile-heading">Contact</span>
            <a href="#contact" class="mobile-link">Get in touch</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    /* Transparent on hero, gets darkened by JS on scroll */
    background: transparent;
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }
  .navbar.scrolled {
    background: rgba(6, 10, 18, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .nav-inner {
    max-width: 100%;
    padding: 0 2.5rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Left ── */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }

  .nav-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.25rem;
    border: 1px solid rgba(255,255,255,0.45);
    border-radius: 999px;
    color: rgba(255,255,255,0.88);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .nav-cta-pill:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.7);
    color: #ffffff;
  }

  .nav-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-social-link {
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }
  .nav-social-link:hover { color: rgba(255,255,255,0.9); }

  /* ── Center Logo ── */
  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .logo-word {
    font-size: 1.2rem;
    font-weight: 900;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
  }
  .logo-sub {
    font-size: 0.5rem;
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  /* ── Right ── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: flex-end;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-link {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover { color: #ffffff; }

  /* MENU button */
  .nav-menu-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.75);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .nav-menu-btn:hover { color: #ffffff; }

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-icon span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transition: all 0.3s;
  }
  .nav-menu-btn.open .menu-icon span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav-menu-btn.open .menu-icon span:nth-child(2) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ── Mobile Menu Overlay ── */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    background: #090d14;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mobile-menu.open {
    opacity: 1;
    pointer-events: all;
    z-index: 199;
  }
  .mobile-menu-inner {
    max-width: 700px;
    width: 100%;
    padding: 2rem;
  }
  .mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .mobile-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mobile-heading {
    color: rgba(255,255,255,0.3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .mobile-link {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }
  .mobile-link:hover { color: #ffffff; }

  /* Responsive */
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-social { display: none; }
  }
  @media (max-width: 600px) {
    .nav-inner { padding: 0 1.5rem; }
    .nav-cta-pill { padding: 0.45rem 0.9rem; font-size: 0.65rem; }
    .mobile-grid { grid-template-columns: 1fr; gap: 2rem; }
    .mobile-link { font-size: 1.15rem; }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const navbar = document.getElementById('navbar');

  // Toggle mobile menu
  btn?.addEventListener('click', () => {
    const isOpen = btn.classList.toggle('open');
    menu?.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn?.classList.remove('open');
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });

  // Scroll: add .scrolled class when past viewport
  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  }
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

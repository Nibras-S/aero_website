---
import { countryCodes } from "../../data/countryCodes";

export interface Props {
  name?: string;
  defaultValue?: string;
  className?: string;
}

const { name = "countryCode", defaultValue = "+971", className = "" } = Astro.props;
const defaultCountry = countryCodes.find(c => c.code === defaultValue) || countryCodes[0];
---

<div class={`custom-country-select ${className}`} data-name={name}>
  <!-- Hidden input for form submission -->
  <input type="hidden" name={name} value={defaultValue} class="real-input" required />

  <!-- Trigger Button -->
  <button type="button" class="select-trigger" aria-haspopup="listbox" aria-expanded="false">
    <span class="selected-value">
      {defaultCountry.flag} <span class="selected-code">{defaultCountry.code}</span>
    </span>
    <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="select-dropdown" role="listbox">
    <div class="search-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search country or code..." aria-label="Search countries" />
    </div>
    
    <ul class="options-list">
      {countryCodes.map((c) => (
        <li
          class={`option-item ${c.code === defaultValue ? 'selected' : ''}`}
          role="option"
          aria-selected={c.code === defaultValue ? "true" : "false"}
          data-value={c.code}
          data-search={`${c.name} ${c.code}`.toLowerCase()}
        >
          <span class="option-flag">{c.flag}</span>
          <span class="option-name">{c.name}</span>
          <span class="option-code">{c.code}</span>
        </li>
      ))}
      <li class="no-results hidden">No countries found</li>
    </ul>
  </div>
</div>

<style>
  .custom-country-select {
    position: relative;
    width: 100%;
    /* Let the parent element dictate width, but ensure it behaves as a block */
    display: block;
    user-select: none;
  }

  .select-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
    height: 100%;
  }
  
  /* Fallback for form inputs specific contexts */
  :global(.premium-contact-form) .select-trigger {
    background: rgba(255, 255, 255, 0.04);
    padding: 0.7rem 1rem;
  }

  .select-trigger:focus,
  .custom-country-select.open .select-trigger {
    outline: none;
    border-color: var(--color-primary, #4ba3c3);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: 0 0 0 3px rgba(75, 163, 195, 0.15);
  }

  .selected-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .select-arrow {
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.5);
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .custom-country-select.open .select-arrow {
    transform: rotate(180deg);
  }

  /* Dropdown Styles */
  .select-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 320px; /* Wider to show country names clearly */
    background: #0d1b2a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }
  
  @media (max-width: 480px) {
    .select-dropdown {
      width: 280px; /* Slightly narrower on very small mobile devices */
      max-width: 90vw;
    }
  }

  .custom-country-select.open .select-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Open upwards if inside a constrained area (optional, can be handled via JS if needed, but fixed top by default) */

  .search-wrapper {
    position: relative;
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.2);
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.4);
  }

  .search-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 0.6rem 0.75rem 0.6rem 2.25rem;
    color: #ffffff;
    font-size: 0.9rem;
    font-family: var(--font-body, "Inter", sans-serif);
    transition: all 0.2s;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary, #4ba3c3);
    background: rgba(255, 255, 255, 0.1);
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .options-list {
    max-height: 250px;
    overflow-y: auto;
    padding: 0.5rem 0;
    list-style: none;
    margin: 0;
    /* Custom scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .options-list::-webkit-scrollbar {
    width: 6px;
  }
  .options-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .options-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  .option-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    transition: all 0.2s;
  }

  .option-item:hover, .option-item.highlighted {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .option-item.selected {
    background: rgba(75, 163, 195, 0.1);
    color: var(--color-primary, #4ba3c3);
    font-weight: 500;
  }

  .option-flag {
    font-size: 1.1em;
  }

  .option-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .option-code {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  .option-item.selected .option-code {
    opacity: 1;
  }

  .no-results {
    padding: 1rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9rem;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  class CustomCountrySelect {
    container: HTMLElement;
    trigger: HTMLButtonElement;
    dropdown: HTMLElement;
    searchInput: HTMLInputElement;
    options: NodeListOf<HTMLElement>;
    realInput: HTMLInputElement;
    selectedValueDisplay: HTMLElement;
    noResults: HTMLElement;

    constructor(el: HTMLElement) {
      this.container = el;
      this.trigger = el.querySelector('.select-trigger') as HTMLButtonElement;
      this.dropdown = el.querySelector('.select-dropdown') as HTMLElement;
      this.searchInput = el.querySelector('.search-input') as HTMLInputElement;
      this.options = el.querySelectorAll('.option-item');
      this.realInput = el.querySelector('.real-input') as HTMLInputElement;
      this.selectedValueDisplay = el.querySelector('.selected-value') as HTMLElement;
      this.noResults = el.querySelector('.no-results') as HTMLElement;

      this.init();
    }

    init() {
      // Toggle dropdown
      this.trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.toggleDropdown();
      });

      // Filter options on input
      this.searchInput.addEventListener('input', () => this.filterOptions());

      // Prevent dropdown from closing when clicking inside
      this.dropdown.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Select an option
      this.options.forEach(option => {
        option.addEventListener('click', () => {
          this.selectOption(option);
          this.closeDropdown();
        });
      });

      // Keyboard navigation support
      this.searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.closeDropdown();
          this.trigger.focus();
        }
      });
    }

    toggleDropdown() {
      const isOpen = this.container.classList.contains('open');
      
      // Close all other instances first
      document.querySelectorAll('.custom-country-select.open').forEach(el => {
        if (el !== this.container) el.classList.remove('open');
      });

      if (isOpen) {
        this.closeDropdown();
      } else {
        this.openDropdown();
      }
    }

    openDropdown() {
      this.container.classList.add('open');
      this.trigger.setAttribute('aria-expanded', 'true');
      this.searchInput.value = '';
      this.filterOptions(); // reset filter
      
      // Scroll selected item into view
      const selected = this.container.querySelector('.option-item.selected') as HTMLElement;
      if (selected) {
        setTimeout(() => {
          selected.scrollIntoView({ block: 'nearest' });
        }, 50);
      }
      
      setTimeout(() => {
        this.searchInput.focus();
      }, 100);
    }

    closeDropdown() {
      this.container.classList.remove('open');
      this.trigger.setAttribute('aria-expanded', 'false');
    }

    selectOption(optionEle: HTMLElement) {
      // Update UI state
      this.options.forEach(opt => {
        opt.classList.remove('selected');
        opt.setAttribute('aria-selected', 'false');
      });
      optionEle.classList.add('selected');
      optionEle.setAttribute('aria-selected', 'true');

      // Update actual value
      const value = optionEle.getAttribute('data-value') as string;
      const flag = optionEle.querySelector('.option-flag')?.textContent || '';
      
      this.realInput.value = value;
      this.selectedValueDisplay.innerHTML = `${flag} <span class="selected-code">${value}</span>`;
      
      // Dispatch change event so parsers/listeners on the form know the value changed
      this.realInput.dispatchEvent(new Event('change', { bubbles: true }));
    }

    filterOptions() {
      const query = this.searchInput.value.toLowerCase().trim();
      let hasVisible = false;

      this.options.forEach(option => {
        const searchKeywords = option.getAttribute('data-search') || '';
        if (searchKeywords.includes(query)) {
          option.classList.remove('hidden');
          hasVisible = true;
        } else {
          option.classList.add('hidden');
        }
      });

      if (!hasVisible) {
        this.noResults.classList.remove('hidden');
      } else {
        this.noResults.classList.add('hidden');
      }
    }
  }

  // Init all custom selects on the page
  const initCustomSelects = () => {
    document.querySelectorAll('.custom-country-select').forEach(el => {
      // Prevent double init
      if (!(el as any)._customSelectInst) {
        (el as any)._customSelectInst = new CustomCountrySelect(el as HTMLElement);
      }
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.custom-country-select.open').forEach(el => {
        const wrap = el as HTMLElement;
        if (!wrap.contains(e.target as Node)) {
          wrap.classList.remove('open');
          const trigger = wrap.querySelector('.select-trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
    });
  };

  // Run on first load and on astro page transitions
  document.addEventListener('DOMContentLoaded', initCustomSelects);
  document.addEventListener('astro:page-load', initCustomSelects);
</script>
